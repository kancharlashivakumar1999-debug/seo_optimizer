@{
    ViewData["Title"] = "SEO Rankline Dashboard";
}

<style>
/* Base overrides matching the reference design */
:root {
  --c-bg: var(--surface);
  --c-border: var(--line);
  --c-text: var(--ink);
  --c-sub: var(--ink-2);
  --c-muted: var(--ink-3);
  --c-accent: var(--accent);
  --c-accent-bg: var(--accent-soft);
  --c-up: var(--up);
  --c-up-bg: var(--up-soft);
  --c-dn: var(--down);
  --c-dn-bg: var(--down-soft);
  --c-gold: var(--gold);
  --c-gold-bg: var(--gold-soft);
}

.c-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px 16px;
  position: relative;
}
.c-lbl { font-size: 12px; color: var(--c-sub); margin: 0; }
.c-num { font-size: 22px; font-weight: 700; margin: 3px 0 0; font-variant-numeric: tabular-nums; line-height: 1.2; }
.c-ic {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.pill {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 999px;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.chip {
  font-size: 12px;
  font-weight: 500;
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--c-sub);
  background: var(--surface);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all .15s ease;
}
.chip:hover { border-color: var(--c-accent); color: var(--c-text); }
.chip.on { background: var(--surface-2); color: var(--c-text); border-color: var(--line); font-weight: 600; }
.tbl-custom td, .tbl-custom th {
  padding: 10px 8px;
  font-size: 13px;
  text-align: left;
  border-bottom: 1px solid var(--line);
  font-variant-numeric: tabular-nums;
}
.tbl-custom th {
  font-size: 11.5px;
  color: var(--c-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .03em;
}
.tbl-custom tr:last-child td { border-bottom: none; }
.up { color: var(--c-up); }
.dn { color: var(--c-dn); }
.mv-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid var(--line);
  font-size: 13px;
}
.mv-item:last-child { border-bottom: none; }
.spin {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(0,0,0,0.15);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- SPA View Mount Container -->
<div id="dynamicContainer"></div>

@section Modals {
<!-- Task modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="taskModal" role="dialog" aria-modal="true" aria-labelledby="tmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="tmTitle" style="display:flex;align-items:center;gap:8px;"><i class="ti ti-plus"></i> New ranking task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="row2">
        <div class="field">
          <label for="fName">Task name</label>
          <input id="fName" placeholder="e.g. sparity, acme-shoes, foodiehub">
        </div>
        <div class="field">
          <label for="fSite">Website to track</label>
          <input id="fSite" placeholder="e.g. sparity.com">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="fKeyword">Target Keyword</label>
          <input id="fKeyword" placeholder="e.g. seo audit tool, cheap vps hosting">
          <span class="hint">Single target keyword evaluated in live SERP.</span>
        </div>
        <div class="field">
          <label for="fLocation">Target Location</label>
          <input id="fLocation" placeholder="e.g. Hyderabad, London, Austin">
          <span class="hint">Google geographic search location.</span>
        </div>
      </div>
      <div class="field">
        <label for="fPrompt">Prompt used to check rank &amp; competitor gap</label>
        <textarea id="fPrompt"></textarea>
        <div class="placeholder-btns">
          <span class="hint">Insert:</span>
          <button type="button" data-ph="{keyword}">{keyword}</button>
          <button type="button" data-ph="{location}">{location}</button>
          <button type="button" data-ph="{website}">{website}</button>
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label>Check engine</label>
          <div class="seg" id="engSeg"><button type="button" data-v="ai" class="on"><i class="ti ti-sparkles"></i> Live SERP + RAG</button></div>
          <span class="hint" id="engHint">Live queries SERP provider, cleans competitor pages, and stores chunks in vector store.</span>
        </div>
        <div class="field">
          <label for="fRepeats">Checks per run</label>
          <select id="fRepeats"><option value="1" selected>1 – single check</option><option value="3">3 – average of 3</option></select>
        </div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close>Cancel</button>
      <button class="btn primary" id="saveTask">Create task</button>
    </div>
  </div>
</div>

<!-- Run modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="runModal" role="dialog" aria-modal="true" aria-labelledby="rmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="rmTitle" style="display:flex;align-items:center;gap:8px;"><i class="ti ti-player-play"></i> Run Task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="field">
        <label for="fNote">Notes for this run</label>
        <textarea id="fNote" placeholder="e.g. Added FAQ schema, updated page H1s, published content refresh"></textarea>
      </div>
      <div id="runProg" hidden>
        <div class="progress"><i id="runBar"></i></div>
        <div class="run-status" id="runText" style="font-size:13px;margin-top:6px;display:flex;align-items:center;gap:6px;"></div>
      </div>
      <div id="ragInspectBox" style="display:none;background:var(--surface-2);border-radius:var(--radius);padding:12px;font-size:13px;margin-top:10px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <strong>Generated RAG Input Ready:</strong>
        </div>
        <div id="ragInspectSummary" style="margin-top:6px;max-height:140px;overflow:auto;font-family:monospace;font-size:11.5px;"></div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close id="runCancel">Cancel</button>
      <button class="btn primary" id="runGo"><i class="ti ti-player-play"></i> Start run now</button>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
(() => {
/* ---------- helpers ---------- */
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtDate=t=>new Date(t).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"});
const fmtDT=t=>new Date(t).toLocaleString(undefined,{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"});
const normDomain=s=>String(s||"").toLowerCase().replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#\s]/)[0].trim();
const DEFAULT_PROMPT="Analyze SERP ranking for {keyword} in {location} for website {website}. Identify top competitors, extract key topics and recommend content optimizations.";

function toast(msg, isError = false){
  const t=$("#toast");
  if(!t) return;
  t.textContent=msg;
  t.className = isError ? "toast show error" : "toast show success";
  clearTimeout(toast._t);
  toast._t=setTimeout(()=>{
    t.className="toast";
  }, isError ? 6500 : 3000);
}

// Global fetch interceptor to catch any server or network error centrally
const originalFetch = window.fetch;
window.fetch = async function(...args) {
  try {
    const response = await originalFetch.apply(this, args);
    if (!response.ok) {
      let errText = "HTTP " + response.status + ": " + response.statusText;
      try {
        const cloned = response.clone();
        const errJson = await cloned.json();
        errText = errJson.message || errJson.title || errJson.detail || errText;
      } catch(e) {
        try {
          const raw = await response.clone().text();
          if (raw) errText = raw.length > 200 ? raw.slice(0, 200) + "..." : raw;
        } catch(_) {}
      }
      toast(errText, true);
    }
    return response;
  } catch (netErr) {
    toast("Network Error: " + netErr.message, true);
    throw netErr;
  }
};

/* ---------- state ---------- */
let tasks = [];
let reports = [];
let dashboardMetrics = null;
let biggestMoves = [];
let currentRagInputs = {};
let currentAnalyses = {};
let activeChart = null;
let chartFocusIndex = null;

const THEME_COLORS = ['#2a78d6', '#eb6834', '#199e70', '#c98500', '#827dbd', '#d55181', '#3bbd8c', '#5598e7'];
const DASH_PATTERNS = [[], [6, 4], [2, 3], [10, 3, 2, 3], [4, 4], [8, 4], [3, 3], []];

async function syncFromDb(){
  try {
    const res = await fetch("/Dashboard/GetDashboardState");
    if(res.ok) {
      const data = await res.json();
      if(data.success) {
        dashboardMetrics = data.metrics || null;
        biggestMoves = data.biggestMoves || [];
        reports = data.reports || [];
        
        if(data.tasks && data.tasks.length) {
          tasks = data.tasks.map((t, idx) => {
            let kwList = [];
            try { kwList = JSON.parse(t.targetKeywordsJson || "[]"); } catch(e){}
            let locList = [];
            try { locList = JSON.parse(t.targetLocationsJson || "[]"); } catch(e){}

            const ranks = (t.recentRanks && t.recentRanks.length) 
              ? t.recentRanks.map(v => Number(v))
              : (t.latestAverageRank ? [Number(t.latestAverageRank)] : []);

            return {
              id: t.taskId,
              name: t.taskName || t.targetWebsite,
              website: t.targetWebsite,
              keyword: t.targetKeyword || (kwList.length ? kwList[0] : "General SEO"),
              location: t.targetLocation || (locList.length ? locList[0] : "Global"),
              keywords: kwList.length ? kwList : [t.targetKeyword || "General SEO"],
              locations: locList.length ? locList : [t.targetLocation || "Global"],
              prompt: t.promptTemplate || DEFAULT_PROMPT,
              totalRuns: t.totalRuns || 0,
              latestRank: t.latestAverageRank != null ? Number(t.latestAverageRank) : null,
              previousRank: t.previousAverageRank != null ? Number(t.previousAverageRank) : null,
              lastRunAt: t.lastRunAt || t.updatedAt || t.createdAt,
              recentRanks: ranks,
              color: THEME_COLORS[idx % THEME_COLORS.length],
              dash: DASH_PATTERNS[idx % DASH_PATTERNS.length]
            };
          });
        }
      }
    }
  } catch(e) {
    console.warn("DB sync warning:", e);
  }
}

async function saveTask(t){
  try {
    const res = await fetch("/Dashboard/SaveTask", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(t)
    });
    if (res.ok) {
      await syncFromDb();
      return true;
    }
    return false;
  } catch(e){
    toast("Failed to save task: " + e.message, true);
    return false;
  }
}

async function removeTask(id){
  try {
    const res = await fetch("/Dashboard/DeleteTask?id=" + encodeURIComponent(id), { method: "DELETE" });
    if(res.ok) {
      await syncFromDb();
      return true;
    }
    return false;
  } catch(e){
    toast("Failed to delete task: " + e.message, true);
    return false;
  }
}

function setStatus(){
  const s1 = $("#storeStatus"), s2 = $("#engineStatus");
  if(s1) s1.innerHTML = '<i class="ti ti-database" style="color:var(--up);margin-right:6px"></i>PostgreSQL';
  if(s2) s2.innerHTML = '<i class="ti ti-sparkles" style="color:var(--up);margin-right:6px"></i>SERP + Gemini';
}

function fmtRank(r){
  if(r == null) return "–";
  const num = typeof r === "number" ? r : parseFloat(r);
  if(isNaN(num)) return "–";
  if(num >= 101) return "100+";
  return "#" + (Math.round(num * 10) / 10).toString();
}

/* ---------- Execute Live SERP API + Prepare RAG Input ---------- */
async function executeLiveRun(t, note, implemented){
  const bar = $("#runBar"), txt = $("#runText");
  $("#runProg").hidden = false;
  const kw = t.keyword || (t.keywords && t.keywords[0]) || "";
  const loc = t.location || (t.locations && t.locations[0]) || "";
  txt.innerHTML = `<span class="spin"></span> Querying live SERP for "${esc(kw)}" in "${esc(loc)}"...`;
  bar.style.width = "30%";

  try {
    const response = await fetch("/Dashboard/RunSerpAnalysis", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        taskId: t.id,
        taskName: t.name,
        website: t.website,
        keyword: kw,
        location: loc,
        keywords: [kw],
        locations: [loc],
        note: note,
        implemented: implemented
      })
    });

    if(!response.ok) {
      throw new Error("HTTP error " + response.status);
    }

    bar.style.width = "75%";
    txt.innerHTML = `<span class="spin"></span> Vectorizing competitor chunks and saving to database...`;

    const data = await response.json();
    bar.style.width = "100%";
    txt.innerHTML = `<i class="ti ti-check" style="color:var(--up);"></i> SERP data &amp; RAG inputs prepared!`;

    // Cache RAG payload
    if (data.report && data.report.id) {
      currentRagInputs[data.report.id] = data.ragInputs;
    }
    if (data.runId) {
      currentRagInputs[data.runId] = data.ragInputs;
    }

    // Show preview of RAG Input
    $("#ragInspectBox").style.display = "block";
    $("#ragInspectSummary").innerHTML = esc(JSON.stringify(data.ragInputs && data.ragInputs[0] ? data.ragInputs[0] : data.ragInputs, null, 2));

    await syncFromDb();
    return {
      runId: data.runId || data.report?.id,
      reportId: data.report?.id
    };
  } catch(err) {
    txt.innerHTML = `<span style="color:var(--c-dn)">Failed to run: ${esc(err.message)}</span>`;
    return null;
  }
}

/* ---------- Start Analyzing with Google Gemini RAG ---------- */
let isAnalyzingInProgress = false;

async function startAnalyzingRag(reportId) {
  if (isAnalyzingInProgress) {
    console.warn("Analysis is already running for report:", reportId);
    return;
  }
  isAnalyzingInProgress = true;

  const btn = $("#btnStartAnalyzing");
  const box = $("#ragAnalysisOutputBox");
  const spinner = $("#ragAnalysisSpinner");
  const content = $("#ragAnalysisContent");

  if (btn) {
    btn.disabled = true;
    btn.style.pointerEvents = "none";
    btn.innerHTML = `<span class="spin" style="margin-right:6px"></span>Analyzing Top Competitors...`;
  }
  if (box) box.style.display = "block";
  if (spinner) spinner.style.display = "flex";
  if (content) content.style.display = "none";

  try {
    let targetPayload = null;
    let parsedList = currentRagInputs[reportId];

    if (!parsedList || !parsedList.length) {
      const res = await fetch("/Dashboard/GetRunDetail?id=" + encodeURIComponent(reportId));
      if (res.ok) {
        const detail = await res.json();
        if (detail.ragPayload) {
          targetPayload = {
            runId: detail.ragPayload.runId,
            taskId: detail.ragPayload.taskId,
            keyword: detail.ragPayload.targetKeyword,
            location: detail.ragPayload.targetLocation,
            targetWebsite: detail.ragPayload.targetWebsite,
            ownRankPosition: detail.ragPayload.ownRankPosition,
            topCompetitors: JSON.parse(detail.ragPayload.topCompetitorsJson || "[]"),
            peopleAlsoAsk: JSON.parse(detail.ragPayload.peopleAlsoAskJson || "[]"),
            ingestedChunks: JSON.parse(detail.ragPayload.ingestedChunksJson || "[]"),
            systemPrompt: detail.ragPayload.systemPrompt,
            userPrompt: detail.ragPayload.userPrompt
          };
          currentRagInputs[reportId] = [targetPayload];
        }
      }
    } else {
      targetPayload = parsedList[0];
    }

    if (!targetPayload) throw new Error("No RAG input payload found for this run.");

    const response = await fetch("/Dashboard/StartAnalyzing", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(targetPayload)
    });

    if (!response.ok) throw new Error("Analysis request failed with status: " + response.status);

    const result = await response.json();
    const data = result.analysis;

    currentAnalyses[reportId] = data;
    renderAnalysisOutput(data);
    toast("SEO Gap Analysis Completed & Saved in PostgreSQL!");
  } catch (err) {
    toast("Error during analysis: " + err.message, true);
  } finally {
    isAnalyzingInProgress = false;
    if (btn) {
      btn.disabled = false;
      btn.style.pointerEvents = "auto";
      btn.innerHTML = `<i class="ti ti-sparkles"></i> Start Analyzing`;
    }
    if (spinner) spinner.style.display = "none";
    if (content) content.style.display = "block";
  }
}

function prop(obj, ...keys) {
  if (!obj) return undefined;
  for (const k of keys) {
    if (obj[k] !== undefined && obj[k] !== null) return obj[k];
    const lower = k.charAt(0).toLowerCase() + k.slice(1);
    if (obj[lower] !== undefined && obj[lower] !== null) return obj[lower];
    const upper = k.charAt(0).toUpperCase() + k.slice(1);
    if (obj[upper] !== undefined && obj[upper] !== null) return obj[upper];
  }
  return undefined;
}

function renderAnalysisOutput(data) {
  const el = $("#ragAnalysisContent");
  if(!data) { el.innerHTML = "<p style='color:var(--c-muted)'>No analysis available.</p>"; return; }

  const target = prop(data, "targetAnalysis") || {};
  const rankPred = prop(data, "rankPrediction") || {};
  const gap = prop(data, "gapAnalysis") || {};
  const compDeep = prop(data, "competitorDeepDive") || [];
  const mods = prop(data, "recommendedModifications") || {};
  const titleTag = prop(mods, "titleTag") || {};
  const metaDesc = prop(mods, "metaDescription") || {};
  const actionPlan = prop(mods, "actionPlan") || [];

  const curPos = prop(target, "currentPosition") ?? prop(rankPred, "baselinePosition") ?? "–";
  const curPosDisplay = String(curPos).includes("+") || String(curPos).includes("50") ? curPos : `#${curPos}`;
  const projPos = prop(rankPred, "projectedPosition") ?? "–";
  const projPosDisplay = projPos !== "–" && !String(projPos).startsWith("#") ? `#${projPos}` : projPos;
  const intentFit = prop(target, "currentIntentFit") || "Moderate";
  const conf = prop(rankPred, "confidenceScore");
  const confText = typeof conf === 'number' ? (conf * 100).toFixed(0) + "%" : "–";

  el.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
      <div style="background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;">
        <h4 style="color:var(--c-accent);margin:0 0 6px;font-size:13px;display:flex;align-items:center;gap:6px;">
          <i class="ti ti-target-arrow"></i> Target Assessment
        </h4>
        <p style="margin:0 0 4px;font-size:12.5px;"><strong>URL:</strong> ${esc(prop(target, "targetUrl") || "–")}</p>
        <p style="margin:0 0 4px;font-size:12.5px;"><strong>Intent Fit:</strong> <span class="pill ${intentFit==='High'?'up':(intentFit==='Moderate'?'flat':'dn')}">${esc(intentFit)}</span></p>
        <p style="margin:4px 0 0;font-size:12px;color:var(--c-sub);">${esc(prop(target, "overallDrawbackSummary") || "–")}</p>
      </div>

      <div style="background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;">
        <h4 style="color:var(--c-up);margin:0 0 6px;font-size:13px;display:flex;align-items:center;gap:6px;">
          <i class="ti ti-trending-up"></i> Rank Prediction Impact
        </h4>
        <div style="display:flex;gap:12px;align-items:center;margin-bottom:6px;">
          <div><span style="font-size:11px;color:var(--c-muted);">Current</span><div style="font-size:18px;font-weight:700;">${curPosDisplay}</div></div>
          <div><i class="ti ti-arrow-right" style="color:var(--c-muted)"></i></div>
          <div><span style="font-size:11px;color:var(--c-muted);">Projected</span><div style="font-size:18px;font-weight:700;color:var(--c-up);">${projPosDisplay}</div></div>
          <div style="margin-left:auto;"><span class="pill" style="background:var(--c-up-bg);color:var(--c-up);">${esc(prop(rankPred, "projectedRange") || "Top 10")}</span></div>
        </div>
        <p style="margin:0;font-size:12px;color:var(--c-sub);"><strong>Timeline:</strong> ${esc(prop(rankPred, "timelineWeeks") || "–")} | <strong>Confidence:</strong> ${confText}</p>
      </div>
    </div>

    <!-- Competitive Gap Analysis -->
    <div style="background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:14px;">
      <h4 style="margin:0 0 8px;font-size:13px;display:flex;align-items:center;gap:6px;">
        <i class="ti ti-arrows-split-2"></i> Competitive Gap Analysis
      </h4>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <strong style="font-size:12px;color:var(--c-dn);">Our Major Drawbacks:</strong>
          <ul style="font-size:12px;margin:4px 0 0 16px;padding:0;line-height:1.5;">
            ${(prop(gap, "ourMajorDrawbacks") || []).map(d=>`<li>${esc(d)}</li>`).join("")}
          </ul>
        </div>
        <div>
          <strong style="font-size:12px;color:var(--c-up);">Competitor Advantages:</strong>
          <ul style="font-size:12px;margin:4px 0 0 16px;padding:0;line-height:1.5;">
            ${(prop(gap, "competitorAdvantages") || []).map(a=>`<li>${esc(a)}</li>`).join("")}
          </ul>
        </div>
      </div>
    </div>

    <!-- Recommended Modifications -->
    <div style="background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:14px;">
      <h4 style="margin:0 0 8px;font-size:13px;display:flex;align-items:center;gap:6px;">
        <i class="ti ti-list-details"></i> Action Plan &amp; Execution Steps
      </h4>
      <div style="display:flex;flex-direction:column;gap:8px;font-size:12.5px;">
