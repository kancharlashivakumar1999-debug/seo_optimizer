@{
    ViewData["Title"] = "SEO Rankline Dashboard";
}

<!-- SPA View Mount Container -->
<div id="dynamicContainer"></div>

@section Modals {
<!-- Task modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="taskModal" role="dialog" aria-modal="true" aria-labelledby="tmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="tmTitle">New ranking task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="row2">
        <div class="field">
          <label for="fName">Task name</label>
          <input id="fName" placeholder="e.g. Hyderabad dental clinic – local">
        </div>
        <div class="field">
          <label for="fSite">Website to track</label>
          <input id="fSite" placeholder="example.com">
        </div>
      </div>
      <div class="field">
        <label>Keywords</label>
        <div class="tag-input" id="kwBox"><input id="kwIn" placeholder="Type keyword and press Enter"></div>
        <span class="hint">Each keyword is checked in every location.</span>
      </div>
      <div class="field">
        <label>Locations</label>
        <div class="tag-input" id="locBox"><input id="locIn" placeholder="e.g. Hyderabad, India – press Enter"></div>
      </div>
      <div class="field">
        <label for="fPrompt">Prompt used to check rank</label>
        <textarea id="fPrompt"></textarea>
        <div class="placeholder-btns">
          <span class="hint">Insert:</span>
          <button type="button" data-ph="{keyword}">{keyword}</button>
          <button type="button" data-ph="{location}">{location}</button>
          <button type="button" data-ph="{website}">{website}</button>
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label>Check engine</label>
          <div class="seg" id="engSeg"><button type="button" data-v="ai" class="on">Live SERP + RAG</button></div>
          <span class="hint" id="engHint">Live queries SERP provider, cleans competitor pages, and chunks into vector store.</span>
        </div>
        <div class="field">
          <label for="fRepeats">Checks per run</label>
          <select id="fRepeats"><option value="1" selected>1 – single check</option><option value="3">3 – average of 3</option></select>
        </div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close>Cancel</button>
      <button class="btn primary" id="saveTask">Create task</button>
    </div>
  </div>
</div>

<!-- Run modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="runModal" role="dialog" aria-modal="true" aria-labelledby="rmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="rmTitle">Run task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="field" id="implField" hidden>
        <label>Which AI improvements did you implement?</label>
        <div class="impl-list" id="implList"></div>
      </div>
      <div class="field">
        <label for="fNote">Notes for this run</label>
        <textarea id="fNote" placeholder="e.g. Rewrote service page titles, added FAQ schema, published new pages"></textarea>
      </div>
      <div id="runProg" hidden>
        <div class="progress"><i id="runBar"></i></div>
        <div class="run-status" id="runText"></div>
      </div>
      <div id="ragInspectBox" style="display:none;background:var(--surface-2);border-radius:var(--radius);padding:12px;font-size:13px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <strong>Generated RAG Input Ready:</strong>
        </div>
        <div id="ragInspectSummary" style="margin-top:6px;max-height:140px;overflow:auto;font-family:monospace;"></div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close id="runCancel">Cancel</button>
      <button class="btn primary" id="runGo">Start run now</button>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
/* ---------- helpers ---------- */
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
const fmtDate=t=>new Date(t).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"});
const fmtDT=t=>new Date(t).toLocaleString(undefined,{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"});
const NF=101;
const clip=(s,n)=>{s=String(s||"").trim();return s.length>n?s.slice(0,n-1)+"…":s};
const normDomain=s=>String(s||"").toLowerCase().replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#\s]/)[0].trim();
const DEFAULT_PROMPT="Analyze SERP ranking for {keyword} in {location} for website {website}. Identify top competitors, extract key topics and recommend content optimizations.";

function toast(msg){const t=$("#toast");t.textContent=msg;t.classList.add("show");clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove("show"),2600)}
const icons={
  dash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>',
  tasks:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="m3.5 6 1.2 1.2L7 5M3.5 12l1.2 1.2L7 11M3.5 18l1.2 1.2L7 17"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  play:'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z"/></svg>',
  arrow:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  search:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
  spark:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg>'
};

/* ---------- state & local storage (RAM + Local Storage) ---------- */
let tasks=[];
const LS_KEY="seoinsight-tasks-live";
function lsLoad(){try{const r=localStorage.getItem(LS_KEY);return r?JSON.parse(r):[]}catch(e){return[]}}
function lsSave(){try{localStorage.setItem(LS_KEY,JSON.stringify(tasks))}catch(e){}}

function saveTask(t){
  tasks = lsLoad();
  const idx=tasks.findIndex(x=>x.id===t.id);
  if(idx>=0) tasks[idx]=t; else tasks.unshift(t);
  lsSave();
}
function saveRun(t,r){
  tasks = lsLoad();
  const currentTask = tasks.find(x=>x.id===t.id) || t;
  if(!currentTask.runs) currentTask.runs=[];
  currentTask.runs.push(r);
  lsSave();
}
function removeTask(id){
  tasks = lsLoad().filter(x=>x.id!==id);
  lsSave();
}
function setStatus(){
  $("#storeStatus").innerHTML='<span class="dot ok"></span>RAM / Local Storage';
  $("#engineStatus").innerHTML='<span class="dot ok"></span>SERP API + Google Gemini Ready';
}

/* ---------- metrics ---------- */
const runAvg=r=>{const v=(r.results||[]).map(x=>x.rank??NF);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null};
const foundAvg=r=>{if(!r)return null;const v=(r.results||[]).filter(x=>x.rank!=null).map(x=>x.rank);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null};
const lastRun=t=>t.runs&&t.runs.length?t.runs[t.runs.length-1]:null;
const prevRun=t=>t.runs&&t.runs.length>1?t.runs[t.runs.length-2]:null;
const fmtRank=r=>r==null?"–":(Math.round(r*10)/10).toString();
function rankBadge(r){if(r==null)return'<span class="rank nf">Not found</span>';const n=Math.round(r);return`<span class="rank ${n<=3?"t3":n<=10?"t10":""}">${fmtRank(r)}</span>`}
function deltaPill(prev,cur){
  if(prev==null&&cur==null)return'<span class="pill flat">–</span>';
  if(prev==null)return'<span class="pill up">New</span>';
  if(cur==null)return'<span class="pill down">Lost</span>';
  const d=Math.round((prev-cur)*10)/10;
  if(Math.abs(d)<0.05)return'<span class="pill flat">0</span>';
  return d>0?`<span class="pill up">▲ ${d}</span>`:`<span class="pill down">▼ ${Math.abs(d)}</span>`;
}
function pairs(t){const out=[];(t.keywords||[]).forEach(k=>(t.locations||[]).forEach(l=>out.push({keyword:k,location:l})));return out}
function resultFor(run,k,l){return run?(run.results||[]).find(x=>x.keyword===k&&x.location===l):null}
function globalStats(){
  let kw=0,runs=0,top3=0,top10=0,up=0,down=0,sum=0,cnt=0;
  tasks.forEach(t=>{
    kw+=pairs(t).length;runs+=(t.runs||[]).length;
    const L=lastRun(t),P=prevRun(t);if(!L)return;
    (L.results||[]).forEach(r=>{
      if(r.rank!=null){sum+=r.rank;cnt++;if(r.rank<=3.5)top3++;if(r.rank<=10.5)top10++}
      const p=P?resultFor(P,r.keyword,r.location):null;
      if(p){const a=p.rank??NF,b=r.rank??NF;if(b<a-0.05)up++;else if(b>a+0.05)down++}
    });
  });
  return{kw,runs,top3,top10,up,down,avg:cnt?sum/cnt:null};
}

/* ---------- Execute Live SERP API + Prepare RAG Input ---------- */
async function executeLiveRun(t,note,implemented){
  const bar=$("#runBar"),txt=$("#runText");
  $("#runProg").hidden=false;
  txt.textContent="Calling SERP API for "+t.keywords.length+" keyword(s)...";
  bar.style.width="30%";

  try {
    const response = await fetch("/Dashboard/RunSerpAnalysis", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        taskName: t.name,
        website: t.website,
        keywords: t.keywords,
        locations: t.locations,
        note: note,
        implemented: implemented
      })
    });

    if(!response.ok) {
      throw new Error("HTTP error " + response.status);
    }

    bar.style.width="70%";
    txt.textContent="Scraping competitor pages & storing chunks in Vector RAM...";

    const data = await response.json();
    bar.style.width="100%";
    txt.textContent="SERP results & RAG inputs prepared successfully!";

    // Store RAG Inputs locally in RAM/localStorage
    const ragInputsKey = "rag_input_" + data.report.id;
    localStorage.setItem(ragInputsKey, JSON.stringify(data.ragInputs));

    // Show preview of RAG Input
    $("#ragInspectBox").style.display="block";
    $("#ragInspectSummary").innerHTML=esc(JSON.stringify(data.ragInputs[0], null, 2));

    const run={
      id: data.report.id,
      at: Date.now(),
      note: note.trim(),
      implemented: implemented,
      engine: "live-serp",
      repeats: 1,
      results: (data.report.keywordResults||[]).map(kr=>({
        keyword: kr.keyword,
        location: kr.location,
        rank: kr.rank,
        samples: [kr.rank],
        hits: kr.hits,
        top10: (kr.top10||[]).map(item=>({
          rank: item.position,
          name: item.title,
          domain: item.domain,
          why: item.isOwnDomain ? "Your tracked site" : "Organic ranking competitor",
          isMe: item.isOwnDomain
        }))
      })),
      report: {
        source: "serp-live",
        at: Date.now(),
        score: data.report.visibilityScore,
        summary: data.report.summary,
        changeImpact: "Live SERP data fetched and vectorized. RAG input created.",
        wins: data.report.keywordResults.filter(r=>r.rank && r.rank<=3).map(r=>"Top 3 rank achieved for "+r.keyword),
        issues: data.report.keywordResults.filter(r=>!r.rank || r.rank>10).map(r=>"Outside top 10 for "+r.keyword),
        patterns: ["Competitors have dedicated keyword URLs and extensive schema."],
        competitors: (data.report.keywordResults[0]?.top10||[]).slice(0,4).map(c=>({ domain: c.domain, name: c.title, whyTop: c.snippet })),
        recommendations: []
      },
      ragInputId: ragInputsKey
    };

    return run;
  } catch(err) {
    txt.textContent="Failed to run: " + err.message;
    return null;
  }
}

/* ---------- Start Analyzing with Azure OpenAI RAG ---------- */
async function startAnalyzingRag(reportId, ragInputIndex = 0) {
  const btn = $("#btnStartAnalyzing");
  const box = $("#ragAnalysisOutputBox");
  const spinner = $("#ragAnalysisSpinner");
  const content = $("#ragAnalysisContent");

  btn.disabled = true;
  btn.innerHTML = `<span class="spin" style="display:inline-block;margin-right:6px"></span>Analyzing Top 5 Competitors...`;
  box.style.display = "block";
  spinner.style.display = "flex";
  content.style.display = "none";

  try {
    const rawData = localStorage.getItem("rag_input_" + reportId);
    if (!rawData) throw new Error("No RAG input payload found for this report.");
    const parsedList = JSON.parse(rawData);
    const targetPayload = parsedList[ragInputIndex] || parsedList[0];

    const response = await fetch("/Dashboard/StartAnalyzing", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(targetPayload)
    });

    if (!response.ok) throw new Error("Analysis request failed with status: " + response.status);

    const result = await response.json();
    const data = result.analysis;

    // Cache analysis output with the report
    localStorage.setItem("analysis_output_" + reportId, JSON.stringify(data));

    // Render structured results
    renderAnalysisOutput(data);
    toast("Principal SEO Gap Analysis Completed!");
  } catch (err) {
    alert("Error during analysis: " + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = `${icons.spark}Start Analyzing`;
    spinner.style.display = "none";
    content.style.display = "block";
  }
}

