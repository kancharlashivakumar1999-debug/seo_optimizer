          </tbody>
        </table>
      </div>
    </div>

    <!-- Raw JSON Inspector toggle -->
    <details style="margin-top:10px;">
      <summary style="font-size:12.5px;color:var(--accent);cursor:pointer;font-weight:600;">View Raw Output JSON</summary>
      <pre style="background:var(--surface-2);border-radius:var(--radius);padding:10px;margin-top:8px;font-size:11.5px;max-height:260px;overflow:auto;">${esc(JSON.stringify(data, null, 2))}</pre>
    </details>
  `;
}

/* ---------- routing & nav ---------- */
let charts=[];
function killCharts(){charts.forEach(c=>c.destroy());charts=[]}
function navHTML(active){return`<a href="#dashboard" class="${active==="dashboard"?"on":""}">${icons.dash}<span>Dashboard</span></a><a href="#tasks" class="${active!=="dashboard"?"on":""}">${icons.tasks}<span>Tasks</span></a>`}
let detailTab="overview";

function route(){
  tasks = lsLoad(); // Always reload state from storage on route change
  killCharts();
  const h=location.hash.slice(1)||"dashboard";
  const deep=h.startsWith("task-")||h.startsWith("report-");
  $("#nav").innerHTML=navHTML(deep?"tasks":h);$("#navM").innerHTML=navHTML(deep?"tasks":h);

  if(h.startsWith("report-")){
    const m=h.match(/^report-([a-z0-9]+)-(\d+)$/);
    const t=m&&tasks.find(x=>x.id===m[1]);
    const i=m?+m[2]-1:-1;
    if(t&&t.runs[i]){window.scrollTo(0,0);return renderReport(t,i)}
    location.hash="tasks";return;
  }
  if(h.startsWith("task-")){
    const t=tasks.find(x=>"task-"+x.id===h);
    if(t)return renderDetail(t);
    location.hash="tasks";return;
  }
  if(h==="tasks")return renderTasks();
  renderDashboard();
}
window.addEventListener("hashchange",()=>{if(!location.hash.startsWith("#task-"))detailTab="overview";route()});
const reportHash=(t,i)=>`report-${t.id}-${i+1}`;

/* ---------- chart theming ---------- */
const css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();
const PALETTE=()=>[css("--accent"),css("--up"),css("--gold"),css("--down"),"#8B5CF6","#0EA5B7","#D9468F","#64748B"];
function baseOpts(rankAxis=true){
  const grid=css("--line"),tick=css("--ink-3");
  return{responsive:true,maintainAspectRatio:false,interaction:{mode:"index",intersect:false},
    plugins:{legend:{labels:{color:css("--ink-2"),boxWidth:10,boxHeight:10,usePointStyle:true,font:{family:"Schibsted Grotesk"}}}},
    scales:{x:{grid:{display:false},ticks:{color:tick,font:{family:"Schibsted Grotesk"}}},
      y:{reverse:rankAxis,min:rankAxis?1:undefined,grid:{color:grid},ticks:{color:tick,precision:0,font:{family:"Schibsted Grotesk"},callback:rankAxis?(v=>"#"+v):undefined}}}};
}
function mkChart(el,cfg){if(!window.Chart||!el)return;charts.push(new Chart(el,cfg))}

function emptyState(){
  return`<div class="panel empty"><h2>No ranking tasks found</h2><p>Click "New task" to configure your website, keywords and location. Clicking "Run now" will query the live SERP API and chunk data into vector storage.</p>
  <div class="acts"><button class="btn primary" data-new>${icons.plus}New task</button></div></div>`;
}

/* ---------- Dashboard ---------- */
function renderDashboard(){
  tasks = lsLoad();
  const v=$("#dynamicContainer");const s=globalStats();
  v.innerHTML=`<div class="head"><div><h1>Dashboard</h1><p>${tasks.length?`${tasks.length} task${tasks.length>1?"s":""} tracking ${s.kw} keyword–location pairs`:"No tasks configured"}</p></div>
    <button class="btn primary" data-new>${icons.plus}New task</button></div>
  ${tasks.length?`
  <div class="kpis">
    <div class="kpi"><div class="v">${fmtRank(s.avg)}</div><div class="l">Average rank (found)</div></div>
    <div class="kpi"><div class="v">${s.top10}</div><div class="l">In top 10</div></div>
    <div class="kpi"><div class="v" style="color:var(--up)">${s.up}</div><div class="l">Improved last run</div></div>
    <div class="kpi"><div class="v" style="color:var(--down)">${s.down}</div><div class="l">Dropped last run</div></div>
    <div class="kpi"><div class="v">${s.runs}</div><div class="l">Runs completed</div></div>
    <div class="kpi"><div class="v">${s.kw}</div><div class="l">Keywords Tracked</div></div>
  </div>
  <div class="grid g-2-1" style="margin-bottom:18px">
    <div class="panel"><h2>Average rank by run</h2><p class="sub">Line per task</p><div class="chart-box"><canvas id="cTrend"></canvas></div></div>
    <div class="panel"><h2>Biggest moves</h2><p class="sub">Latest run vs previous</p><div class="ladder" id="movers"></div></div>
  </div>
  <div class="panel"><h2>Recent run reports</h2><p class="sub">Click a row to open report &amp; RAG input</p><div class="tbl-wrap"><table><thead><tr><th>Task</th><th>When</th><th class="num">Score</th><th class="num">Avg rank</th><th class="num">Status</th></tr></thead><tbody id="recent"></tbody></table></div></div>
  `:emptyState()}`;

  if(!tasks.length)return;
  const maxRuns=Math.max(...tasks.map(t=>(t.runs||[]).length),1);const pal=PALETTE();
  mkChart($("#cTrend"),{type:"line",data:{labels:Array.from({length:maxRuns},(_,i)=>"Run "+(i+1)),
    datasets:tasks.filter(t=>t.runs&&t.runs.length).slice(0,8).map((t,i)=>({label:t.name,data:t.runs.map(r=>Math.round(runAvg(r)*10)/10),borderColor:pal[i%pal.length],tension:.3,borderWidth:2.5,pointRadius:3}))},options:baseOpts(true)});

  const rec=[];tasks.forEach(t=>(t.runs||[]).forEach((r,i)=>rec.push({t,r,i})));
  rec.sort((a,b)=>b.r.at-a.r.at);
  $("#recent").innerHTML=rec.slice(0,7).map(x=>`<tr class="click" data-href="${reportHash(x.t,x.i)}"><td><b>${esc(x.t.name)}</b> <span class="muted">Run ${x.i+1}</span></td><td class="muted">${fmtDT(x.r.at)}</td><td class="num">${x.r.report?x.r.report.score:"–"}</td><td class="num">${fmtRank(runAvg(x.r))}</td><td class="num"><span class="pill up">RAG Ready</span></td></tr>`).join("")||'<tr><td colspan="5" class="muted">No runs completed yet – open a task and click Run.</td></tr>';
}

/* ---------- Tasks list ---------- */
function renderTasks(){
  tasks = lsLoad(); // Direct reactive refresh
  const v=$("#dynamicContainer");
  v.innerHTML=`<div class="head"><div><h1>Ranking tasks</h1><p>Configured domains and target keywords.</p></div><button class="btn primary" data-new>${icons.plus}New task</button></div>
  ${tasks.length?`
  <div class="panel list-panel">
    <div class="task-row head-row"><span>Task</span><span class="c-loc">Locations</span><span class="c-kw">Keywords</span><span class="c-last">Latest Rank</span><span></span></div>
    ${tasks.map(t=>{const L=lastRun(t);return`<div class="task-row" data-go="${t.id}">
      <div style="min-width:0"><div class="t-name">${esc(t.name)}</div><div class="t-site">${esc(t.website)} – ${(t.runs||[]).length} run(s)</div></div>
      <div class="c-loc chips">${(t.locations||[]).map(l=>`<span class="chip">${esc(l)}</span>`).join("")}</div>
      <div class="c-kw">${(t.keywords||[]).length}</div>
      <div class="c-last"><span class="big-rank">${L?fmtRank(runAvg(L)):"–"}</span></div>
      <div><button class="btn sm primary" data-run="${t.id}">${icons.play}Run now</button></div>
    </div>`}).join("")}
  </div>`:emptyState()}`;
}

/* ---------- Task detail ---------- */
function renderDetail(t){
  tasks = lsLoad();
  const current = tasks.find(x=>x.id===t.id) || t;
  const v=$("#dynamicContainer");const L=lastRun(current);
  v.innerHTML=`<div class="crumb"><a href="#tasks">Tasks</a> / ${esc(current.name)}</div>
  <div class="head"><div><h1>${esc(current.name)}</h1>
    <div class="meta-row"><span>Website: <b>${esc(current.website)}</b></span><span>Keywords: <b>${(current.keywords||[]).join(", ")}</b></span><span>Locations: <b>${(current.locations||[]).join(", ")}</b></span></div></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn danger" data-del="${current.id}">Delete</button><button class="btn primary" data-run="${current.id}">${icons.play}Run now</button></div></div>
  ${L?`<div class="panel" style="margin-bottom:18px"><h2>Latest Run Results (Live SERP)</h2>
    <div class="tbl-wrap"><table><thead><tr><th>Keyword</th><th>Location</th><th class="num">Rank</th><th>Status</th></tr></thead><tbody>
    ${(L.results||[]).map(r=>`<tr><td><b>${esc(r.keyword)}</b></td><td>${esc(r.location)}</td><td class="num">${rankBadge(r.rank)}</td><td>${r.rank?"Found in SERP":"Not in Top 10"}</td></tr>`).join("")}
    </tbody></table></div></div>`:emptyState()}`;
}

/* ---------- Report Page (with Start Analyzing & RAG Input Display) ---------- */
function renderReport(t,i){
  tasks = lsLoad();
  const current = tasks.find(x=>x.id===t.id) || t;
  const run=current.runs[i];const v=$("#dynamicContainer");
  const ragDataStr=localStorage.getItem("rag_input_" + run.id);
  let ragData = null;
  try { if(ragDataStr) ragData = JSON.parse(ragDataStr); } catch(e){}

  const existingAnalysisStr = localStorage.getItem("analysis_output_" + run.id);
  let existingAnalysis = null;
  try { if(existingAnalysisStr) existingAnalysis = JSON.parse(existingAnalysisStr); } catch(e){}

  v.innerHTML=`<div class="crumb"><a href="#tasks">Tasks</a> / <a href="#task-${current.id}">${esc(current.name)}</a> / Run ${i+1} Report</div>
  <div class="head"><div><h1>Live SERP Run ${i+1} &amp; Competitive Analysis</h1>
    <div class="meta-row"><span>Tracked Site: <b>${esc(current.website)}</b></span><span>Executed: ${fmtDT(run.at)}</span></div></div>
    <div style="display:flex;gap:10px;align-items:center;">
      <button class="btn primary" id="btnStartAnalyzing" onclick="startAnalyzingRag('${run.id}', 0)">${icons.spark}Start Analyzing</button>
      <button class="btn" data-run="${current.id}">${icons.play}Run Again</button>
    </div></div>

  <!-- RAG Analysis Results Container -->
  <div class="panel" id="ragAnalysisOutputBox" style="${existingAnalysis?'':'display:none;'}margin-bottom:18px;border:1.5px solid var(--accent);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <h2>AI Competitive Gap Analysis &amp; Action Plan</h2>
      <span class="pill up">Powered by Google Gemini RAG</span>
    </div>
    <div id="ragAnalysisSpinner" style="display:none;padding:24px 0;justify-content:center;align-items:center;gap:10px;">
      <span class="spin"></span>Analyzing top 5 competitors and calculating rank predictions...
    </div>
    <div id="ragAnalysisContent"></div>
  </div>

  <div class="panel" style="margin-bottom:18px">
    <h2>SERP Organic Results</h2>
    <div class="tbl-wrap"><table><thead><tr><th>Keyword</th><th>Location</th><th class="num">Position</th><th>Top 1 Result</th></tr></thead><tbody>
    ${(run.results||[]).map(r=>`<tr><td><b>${esc(r.keyword)}</b></td><td>${esc(r.location)}</td><td class="num">${rankBadge(r.rank)}</td><td class="muted">${esc(r.top10?.[0]?.name||"–")}</td></tr>`).join("")}
    </tbody></table></div>
  </div>

  <div class="panel" style="margin-bottom:18px">
    <h2>Prepared RAG Input (Stored in RAM / LocalStorage)</h2>
    <p class="sub">Structured context extracted from SERP and competitor scraping ready for Azure OpenAI prompt generation.</p>
    <div style="background:var(--surface-2);border-radius:var(--radius);padding:14px;overflow:auto;max-height:300px;">
      <pre style="margin:0;font-family:monospace;font-size:12.5px;white-space:pre-wrap;">${esc(JSON.stringify(ragData, null, 2))}</pre>
    </div>
  </div>`;

  if(existingAnalysis) {
    renderAnalysisOutput(existingAnalysis);
  }
}

/* ---------- task modal ---------- */
let editId=null,kwTags=[],locTags=[];
function drawTags(box,arr,input){
  $$(".chip",box).forEach(c=>c.remove());
  arr.forEach((tg,i)=>{
    const c=document.createElement("span");
    c.className="chip";
    c.innerHTML=`${esc(tg)}<button type="button" aria-label="Remove ${esc(tg)}">×</button>`;
    c.querySelector("button").onclick=()=>{arr.splice(i,1);drawTags(box,arr,input)};
    box.insertBefore(c,input);
  });
}
function bindTags(box,input,getArr){
  box.onclick=()=>input.focus();
  const add=val=>{val.split(/[\n,;]+/).map(s=>s.trim()).filter(Boolean).forEach(s=>{const a=getArr();if(!a.includes(s))a.push(s)});input.value="";drawTags(box,getArr(),input)};
  input.onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();add(input.value)}else if(e.key==="Backspace"&&!input.value&&getArr().length){getArr().pop();drawTags(box,getArr(),input)}};
  input.onblur=()=>{if(input.value.trim())add(input.value)};
}
bindTags($("#kwBox"),$("#kwIn"),()=>kwTags);
bindTags($("#locBox"),$("#locIn"),()=>locTags);

function openTaskModal(t){
  editId=t?t.id:null;
  $("#tmTitle").textContent=t?"Edit ranking task":"New ranking task";
  $("#fName").value=t?.name||"";
  $("#fSite").value=t?.website||"";
  $("#fPrompt").value=t?.prompt||DEFAULT_PROMPT;
  kwTags=[...(t?.keywords||[])];
  locTags=[...(t?.locations||[])];
  drawTags($("#kwBox"),kwTags,$("#kwIn"));
  drawTags($("#locBox"),locTags,$("#locIn"));
  $("#taskModal").classList.add("open");
  setTimeout(()=>$("#fName").focus(),30);
}

$("#saveTask").onclick=async()=>{
  if($("#kwIn").value.trim()){kwTags.push(...$("#kwIn").value.split(/[\n,;]+/).map(s=>s.trim()).filter(Boolean));$("#kwIn").value=""}
  if($("#locIn").value.trim()){locTags.push(...$("#locIn").value.split(/[\n;]+/).map(s=>s.trim()).filter(Boolean));$("#locIn").value=""}
  const name=$("#fName").value.trim(),site=normDomain($("#fSite").value),prompt=$("#fPrompt").value.trim();
  if(!site){toast("Add website to track");return $("#fSite").focus()}
  if(!kwTags.length){toast("Add at least one keyword");return $("#kwIn").focus()}
  if(!locTags.length){toast("Add at least one location");return $("#locIn").focus()}

  const t={
    id: editId || uid(),
    name: name || site,
    website: site,
    keywords: [...new Set(kwTags)],
    locations: [...new Set(locTags)],
    prompt: prompt,
    runs: []
  };

  saveTask(t);
  closeModals();
  toast("Task created successfully");

  // Immediate UI update to tasks view
  location.hash="tasks";
  route();
};

/* ---------- run modal ---------- */
let runTaskId=null;
function openRunModal(id){
  const currentTasks = lsLoad();
  const t=currentTasks.find(x=>x.id===id);if(!t)return;
  runTaskId=id;
  $("#rmTitle").textContent="Run live SERP: “"+t.name+"”";
  $("#fNote").value="";
  $("#runProg").hidden=true;
  $("#ragInspectBox").style.display="none";
  $("#runBar").style.width="0";
  $("#runGo").disabled=false;
  $("#runModal").classList.add("open");
}

$("#runGo").onclick=async()=>{
  const currentTasks = lsLoad();
  const t=currentTasks.find(x=>x.id===runTaskId);if(!t)return;
  $("#runGo").disabled=true;
  const run = await executeLiveRun(t, $("#fNote").value, []);
  if(run) {
    saveRun(t, run);
    toast("Live SERP queried and RAG Input generated!");
    setTimeout(()=>{
      closeModals();
      location.hash=reportHash(t, (t.runs||[]).length-1);
    }, 1200);
  } else {
    $("#runGo").disabled=false;
  }
};

function closeModals(){$$(".scrim").forEach(m=>m.classList.remove("open"));}
$$("[data-close]").forEach(b=>b.onclick=closeModals);
// Prevent backdrop click from dismissing the modal dialog (close only on completion or close icon/cancel button)

/* ---------- Global clicks ---------- */
document.addEventListener("click",e=>{
  if(e.target.closest("[data-new]")){openTaskModal();return}
  const r=e.target.closest("[data-run]");if(r){e.stopPropagation();openRunModal(r.dataset.run);return}
  const d=e.target.closest("[data-del]");if(d){const currentTasks=lsLoad();const t=currentTasks.find(x=>x.id===d.dataset.del);if(t&&confirm(`Delete “${t.name}”?`)){removeTask(t.id);location.hash="tasks";toast("Task deleted");route();}return}
  const hr=e.target.closest("[data-href]");if(hr){location.hash=hr.dataset.href;return}
  const g=e.target.closest("[data-go]");if(g){location.hash="task-"+g.dataset.go}
});

$("#themeBtn").onclick=()=>{const rt=document.documentElement;const dark=rt.dataset.theme?rt.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches;rt.dataset.theme=dark?"light":"dark";route()};

tasks=lsLoad();
setStatus();
route();
</script>
}
