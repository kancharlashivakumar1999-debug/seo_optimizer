@{
    ViewData["Title"] = "SEO Rankline Dashboard";
}

<!-- SPA View Mount Container -->
<div id="dynamicContainer"></div>

@section Modals {
<!-- Task modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="taskModal" role="dialog" aria-modal="true" aria-labelledby="tmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="tmTitle">New ranking task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="row2">
        <div class="field">
          <label for="fName">Task name</label>
          <input id="fName" placeholder="e.g. Hyderabad dental clinic – local">
        </div>
        <div class="field">
          <label for="fSite">Website to track</label>
          <input id="fSite" placeholder="example.com">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="fKeyword">Target Keyword</label>
          <input id="fKeyword" placeholder="e.g. dental clinic, nocode platform">
          <span class="hint">Single keyword evaluated in live SERP.</span>
        </div>
        <div class="field">
          <label for="fLocation">Target Location</label>
          <input id="fLocation" placeholder="e.g. Hyderabad, Telangana, India">
          <span class="hint">Google geographic search location.</span>
        </div>
      </div>
      <div class="field">
        <label for="fPrompt">Prompt used to check rank</label>
        <textarea id="fPrompt"></textarea>
        <div class="placeholder-btns">
          <span class="hint">Insert:</span>
          <button type="button" data-ph="{keyword}">{keyword}</button>
          <button type="button" data-ph="{location}">{location}</button>
          <button type="button" data-ph="{website}">{website}</button>
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label>Check engine</label>
          <div class="seg" id="engSeg"><button type="button" data-v="ai" class="on">Live SERP + RAG</button></div>
          <span class="hint" id="engHint">Live queries SERP provider, cleans competitor pages, and chunks into vector store.</span>
        </div>
        <div class="field">
          <label for="fRepeats">Checks per run</label>
          <select id="fRepeats"><option value="1" selected>1 – single check</option><option value="3">3 – average of 3</option></select>
        </div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close>Cancel</button>
      <button class="btn primary" id="saveTask">Create task</button>
    </div>
  </div>
</div>

<!-- Run modal: Fixed size, scrollable body, with close icon -->
<div class="scrim" id="runModal" role="dialog" aria-modal="true" aria-labelledby="rmTitle">
  <div class="modal">
    <div class="modal-h">
      <h3 id="rmTitle">Run task</h3>
      <button class="modal-close-btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-b">
      <div class="field" id="implField" hidden>
        <label>Which AI improvements did you implement?</label>
        <div class="impl-list" id="implList"></div>
      </div>
      <div class="field">
        <label for="fNote">Notes for this run</label>
        <textarea id="fNote" placeholder="e.g. Rewrote service page titles, added FAQ schema, published new pages"></textarea>
      </div>
      <div id="runProg" hidden>
        <div class="progress"><i id="runBar"></i></div>
        <div class="run-status" id="runText"></div>
      </div>
      <div id="ragInspectBox" style="display:none;background:var(--surface-2);border-radius:var(--radius);padding:12px;font-size:13px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <strong>Generated RAG Input Ready:</strong>
        </div>
        <div id="ragInspectSummary" style="margin-top:6px;max-height:140px;overflow:auto;font-family:monospace;"></div>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn" data-close id="runCancel">Cancel</button>
      <button class="btn primary" id="runGo">Start run now</button>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
(() => {
/* ---------- helpers ---------- */
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
const fmtDate=t=>new Date(t).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"});
const fmtDT=t=>new Date(t).toLocaleString(undefined,{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"});
const NF=101;
const clip=(s,n)=>{s=String(s||"").trim();return s.length>n?s.slice(0,n-1)+"…":s};
const normDomain=s=>String(s||"").toLowerCase().replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#\s]/)[0].trim();
const DEFAULT_PROMPT="Analyze SERP ranking for {keyword} in {location} for website {website}. Identify top competitors, extract key topics and recommend content optimizations.";

function toast(msg, isError = false){
  const t=$("#toast");
  t.textContent=msg;
  t.className = isError ? "toast show error" : "toast show success";
  clearTimeout(toast._t);
  toast._t=setTimeout(()=>{
    t.className="toast";
  }, isError ? 6500 : 3000);
}

// Global fetch interceptor to catch any server or network error centrally and show in toaster
const originalFetch = window.fetch;
window.fetch = async function(...args) {
  try {
    const response = await originalFetch.apply(this, args);
    if (!response.ok) {
      let errText = "HTTP " + response.status + ": " + response.statusText;
      try {
        const cloned = response.clone();
        const errJson = await cloned.json();
        errText = errJson.message || errJson.title || errJson.detail || errText;
      } catch(e) {
        try {
          const raw = await response.clone().text();
          if (raw) errText = raw.length > 200 ? raw.slice(0, 200) + "..." : raw;
        } catch(_) {}
      }
      toast(errText, true);
    }
    return response;
  } catch (netErr) {
    toast("Network Error: " + netErr.message, true);
    throw netErr;
  }
};

window.addEventListener("unhandledrejection", e => {
  const msg = e.reason?.message || String(e.reason || "Unhandled error");
  toast(msg, true);
});

window.addEventListener("error", e => {
  toast(e.message || "Script error", true);
});
const icons={
  dash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>',
  tasks:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="m3.5 6 1.2 1.2L7 5M3.5 12l1.2 1.2L7 11M3.5 18l1.2 1.2L7 17"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  play:'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z"/></svg>',
  arrow:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  search:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
  spark:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg>'
};

/* ---------- state & database storage (PostgreSQL Database Exclusively) ---------- */
let tasks=[];
let currentRagInputs = {};
let currentAnalyses = {};

async function syncFromDb(){
  try {
    const res = await fetch("/Dashboard/GetDashboardState");
    if(res.ok) {
      const data = await res.json();
      if(data.tasks && data.tasks.length) {
        const dbTasks = [];
        for(const t of data.tasks) {
          let kw = [];
          try { kw = JSON.parse(t.targetKeywordsJson || "[]"); } catch(e){}
          let loc = [];
          try { loc = JSON.parse(t.targetLocationsJson || "[]"); } catch(e){}

          const initialRuns = [];
          if (t.totalRuns > 0) {
            initialRuns.push({
              avgRank: t.latestAverageRank,
              score: 0,
              at: new Date(t.updatedAt || t.createdAt).getTime()
            });
          }

          dbTasks.push({
            id: t.taskId,
            name: t.taskName || t.targetWebsite,
            website: t.targetWebsite,
            keyword: t.targetKeyword || (kw.length ? kw[0] : "General SEO"),
            location: t.targetLocation || (loc.length ? loc[0] : "Global"),
            keywords: [t.targetKeyword || (kw.length ? kw[0] : "General SEO")],
            locations: [t.targetLocation || (loc.length ? loc[0] : "Global")],
            prompt: t.promptTemplate || DEFAULT_PROMPT,
            latestRank: t.latestAverageRank,
            runs: initialRuns
          });
        }
        if(dbTasks.length) {
          tasks = dbTasks;
        }
      }
    }
  } catch(e) {
    console.warn("DB sync warning:", e);
  }
}

async function saveTask(t){
  const idx=tasks.findIndex(x=>x.id===t.id);
  const existingRuns = idx >= 0 ? tasks[idx].runs || [] : [];
  t.runs = existingRuns;
  if(idx>=0) tasks[idx]=t; else tasks.unshift(t);

  try {
    const res = await fetch("/Dashboard/SaveTask", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(t)
    });
    if (res.ok) {
      const data = await res.json();
      if (data.taskId) {
        t.id = data.taskId;
        if (idx >= 0) {
          tasks[idx].id = data.taskId;
        }
      }
      return true;
    } else {
      throw new Error("HTTP " + res.status);
    }
  } catch(e){
    toast("Failed to save task: " + e.message, true);
    return false;
  }
}

async function saveRun(t,r){
  const currentTask = tasks.find(x=>x.id===t.id) || t;
  if(!currentTask.runs) currentTask.runs=[];
  currentTask.runs.push(r);

  try {
    await fetch("/Dashboard/SaveRun", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ task: currentTask, run: r })
    });
  } catch(e){}
}

async function removeTask(id){
  tasks = tasks.filter(x=>x.id!==id);
  try {
    await fetch("/Dashboard/DeleteTask?id=" + encodeURIComponent(id), { method: "DELETE" });
  } catch(e){}
}
function setStatus(){
  $("#storeStatus").innerHTML='<span class="dot ok"></span>PostgreSQL (Dapper + Projected Columns)';
  $("#engineStatus").innerHTML='<span class="dot ok"></span>SERP API + Google Gemini Ready';
}

/* ---------- metrics ---------- */
const runAvg=r=>{
  if(!r) return null;
  if(r.avgRank != null) return r.avgRank;
  const found = (r.results||[]).filter(x=>x.rank!=null).map(x=>x.rank);
  if(found.length) return found.reduce((a,b)=>a+b,0)/found.length;
  const v=(r.results||[]).map(x=>x.rank);
  return v.length ? null : null;
};
const foundAvg=r=>{if(!r)return null;if(r.avgRank!=null)return r.avgRank;const v=(r.results||[]).filter(x=>x.rank!=null).map(x=>x.rank);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null};
const lastRun=t=>t.runs&&t.runs.length?t.runs[0] || t.runs[t.runs.length-1]:null;
const prevRun=t=>t.runs&&t.runs.length>1?t.runs[1] || t.runs[t.runs.length-2]:null;
const fmtRank=r=>{
  if(r==null) return "–";
  const num = typeof r === "number" ? r : parseFloat(r);
  if(isNaN(num)) return "–";
  if(num >= 101) return "100+";
  return (Math.round(num*10)/10).toString();
};
function rankBadge(r){
  if(r==null)return'<span class="rank nf">Not found</span>';
  const num=typeof r==="number"?r:parseFloat(r);
  if(isNaN(num)||num>=101)return'<span class="rank nf">100+</span>';
  const n=Math.round(num);
  return`<span class="rank ${n<=3?"t3":n<=10?"t10":""}">${fmtRank(num)}</span>`;
}
function deltaPill(prev,cur){
  if(prev==null&&cur==null)return'<span class="pill flat">–</span>';
  if(prev==null)return'<span class="pill up">New</span>';
  if(cur==null)return'<span class="pill down">Lost</span>';
  const d=Math.round((prev-cur)*10)/10;
  if(Math.abs(d)<0.05)return'<span class="pill flat">0</span>';
  return d>0?`<span class="pill up">▲ ${d}</span>`:`<span class="pill down">▼ ${Math.abs(d)}</span>`;
}
function pairs(t){const out=[];(t.keywords||[]).forEach(k=>(t.locations||[]).forEach(l=>out.push({keyword:k,location:l})));return out}
function resultFor(run,k,l){return run?(run.results||[]).find(x=>x.keyword===k&&x.location===l):null}
function globalStats(){
  let kw=0,runs=0,top3=0,top10=0,up=0,down=0,sum=0,cnt=0;
  tasks.forEach(t=>{
    kw+=pairs(t).length;runs+=(t.runs||[]).length;
    const L=lastRun(t),P=prevRun(t);if(!L)return;
    (L.results||[]).forEach(r=>{
      if(r.rank!=null){sum+=r.rank;cnt++;if(r.rank<=3.5)top3++;if(r.rank<=10.5)top10++}
      const p=P?resultFor(P,r.keyword,r.location):null;
      if(p){const a=p.rank??NF,b=r.rank??NF;if(b<a-0.05)up++;else if(b>a+0.05)down++}
    });
  });
  return{kw,runs,top3,top10,up,down,avg:cnt?sum/cnt:null};
}

/* ---------- Execute Live SERP API + Prepare RAG Input ---------- */
async function executeLiveRun(t,note,implemented){
  const bar=$("#runBar"),txt=$("#runText");
  $("#runProg").hidden=false;
  const kw = t.keyword || (t.keywords && t.keywords[0]) || "";
  const loc = t.location || (t.locations && t.locations[0]) || "";
  txt.textContent=`Calling SERP API for "${kw}" in "${loc}"...`;
  bar.style.width="30%";

  try {
    const response = await fetch("/Dashboard/RunSerpAnalysis", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        taskId: t.id,
        taskName: t.name,
        website: t.website,
        keyword: kw,
        location: loc,
        keywords: [kw],
        locations: [loc],
        note: note,
        implemented: implemented
      })
    });

    if(!response.ok) {
      throw new Error("HTTP error " + response.status);
    }

    bar.style.width="70%";
    txt.textContent="Scraping competitor pages & storing chunks in Vector RAM...";

    const data = await response.json();
    bar.style.width="100%";
    txt.textContent="SERP results & RAG inputs prepared successfully!";

    // Retain RAG Input for analysis session
    currentRagInputs[data.report.id] = data.ragInputs;
    if (data.runId) {
      currentRagInputs[data.runId] = data.ragInputs;
    }

    // Show preview of RAG Input
    $("#ragInspectBox").style.display="block";
    $("#ragInspectSummary").innerHTML=esc(JSON.stringify(data.ragInputs[0], null, 2));

    const run={
      id: data.report.id,
      at: Date.now(),
      note: note.trim(),
      implemented: implemented,
      engine: "live-serp",
      repeats: 1,
      results: (data.report.keywordResults||[]).map(kr=>({
        keyword: kr.keyword,
        location: kr.location,
        rank: kr.rank,
        samples: [kr.rank],
        hits: kr.hits,
        top10: (kr.top10||[]).map(item=>({
          rank: item.position,
          name: item.title,
          domain: item.domain,
          why: item.isOwnDomain ? "Your tracked site" : "Organic ranking competitor",
          isMe: item.isOwnDomain
        }))
      })),
      report: {
        source: "serp-live",
        at: Date.now(),
        score: data.report.visibilityScore,
        summary: data.report.summary,
        changeImpact: "Live SERP data fetched and vectorized. RAG input created.",
        wins: data.report.keywordResults.filter(r=>r.rank && r.rank<=3).map(r=>"Top 3 rank achieved for "+r.keyword),
        issues: data.report.keywordResults.filter(r=>!r.rank || r.rank>10).map(r=>"Outside top 10 for "+r.keyword),
        patterns: ["Competitors have dedicated keyword URLs and extensive schema."],
        competitors: (data.report.keywordResults[0]?.top10||[]).slice(0,4).map(c=>({ domain: c.domain, name: c.title, whyTop: c.snippet })),
        recommendations: []
      },
      ragInputId: data.report.id
    };

    return run;
  } catch(err) {
    txt.textContent="Failed to run: " + err.message;
    return null;
  }
}

/* ---------- Start Analyzing with Google Gemini RAG ---------- */
async function startAnalyzingRag(reportId, ragInputIndex = 0) {
  const btn = $("#btnStartAnalyzing");
  const box = $("#ragAnalysisOutputBox");
  const spinner = $("#ragAnalysisSpinner");
  const content = $("#ragAnalysisContent");

  btn.disabled = true;
  btn.innerHTML = `<span class="spin" style="display:inline-block;margin-right:6px"></span>Analyzing Top 5 Competitors...`;
  box.style.display = "block";
  spinner.style.display = "flex";
  content.style.display = "none";

  try {
    let parsedList = currentRagInputs[reportId];
    if (!parsedList || !parsedList.length) {
      // Try to load from server database
      const res = await fetch("/Dashboard/GetRunDetail?id=" + encodeURIComponent(reportId));
      if (res.ok) {
        const detail = await res.json();
        if (detail.ragPayload) {
          parsedList = [{
            runId: detail.ragPayload.runId,
            taskId: detail.ragPayload.taskId,
            keyword: detail.ragPayload.targetKeyword,
            location: detail.ragPayload.targetLocation,
            targetWebsite: detail.ragPayload.targetWebsite,
            ownRankPosition: detail.ragPayload.ownRankPosition,
            topCompetitors: JSON.parse(detail.ragPayload.topCompetitorsJson || "[]"),
            peopleAlsoAsk: JSON.parse(detail.ragPayload.peopleAlsoAskJson || "[]"),
            ingestedChunks: JSON.parse(detail.ragPayload.ingestedChunksJson || "[]"),
            systemPrompt: detail.ragPayload.systemPrompt,
            userPrompt: detail.ragPayload.userPrompt
          }];
          currentRagInputs[reportId] = parsedList;
        }
      }
    }

    if (!parsedList || !parsedList.length) throw new Error("No RAG input payload found for this report.");
    const targetPayload = parsedList[ragInputIndex] || parsedList[0];

    const response = await fetch("/Dashboard/StartAnalyzing", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(targetPayload)
    });

    if (!response.ok) throw new Error("Analysis request failed with status: " + response.status);

    const result = await response.json();
    const data = result.analysis;

    // Cache analysis output in memory for current view
    currentAnalyses[reportId] = data;

    // Render structured results
    renderAnalysisOutput(data);
    toast("Principal SEO Gap Analysis Completed & Saved in PostgreSQL!");
  } catch (err) {
    toast("Error during analysis: " + err.message, true);
  } finally {
    btn.disabled = false;
    btn.innerHTML = `${icons.spark}Start Analyzing`;
    spinner.style.display = "none";
    content.style.display = "block";
  }
}

// Helper to safely get properties regardless of PascalCase or camelCase
function prop(obj, ...keys) {
  if (!obj) return undefined;
  for (const k of keys) {
    if (obj[k] !== undefined && obj[k] !== null) return obj[k];
    const lower = k.charAt(0).toLowerCase() + k.slice(1);
    if (obj[lower] !== undefined && obj[lower] !== null) return obj[lower];
    const upper = k.charAt(0).toUpperCase() + k.slice(1);
    if (obj[upper] !== undefined && obj[upper] !== null) return obj[upper];
  }
  return undefined;
}

function renderAnalysisOutput(data) {
  const el = $("#ragAnalysisContent");
  if(!data) { el.innerHTML = "<p class='muted'>No analysis available.</p>"; return; }

  const target = prop(data, "targetAnalysis") || {};
  const rankPred = prop(data, "rankPrediction") || {};
  const gap = prop(data, "gapAnalysis") || {};
  const compDeep = prop(data, "competitorDeepDive") || [];
  const mods = prop(data, "recommendedModifications") || {};
  const titleTag = prop(mods, "titleTag") || {};
  const metaDesc = prop(mods, "metaDescription") || {};
  const actionPlan = prop(mods, "actionPlan") || [];

  const curPos = prop(target, "currentPosition") ?? prop(rankPred, "baselinePosition") ?? "–";
  const curPosDisplay = String(curPos).includes("+") || String(curPos).includes("50") ? curPos : `#${curPos}`;
  const projPos = prop(rankPred, "projectedPosition") ?? "–";
  const projPosDisplay = projPos !== "–" && !String(projPos).startsWith("#") ? `#${projPos}` : projPos;
  const intentFit = prop(target, "currentIntentFit") || "Moderate";
  const conf = prop(rankPred, "confidenceScore");
  const confText = typeof conf === 'number' ? (conf * 100).toFixed(0) + "%" : "–";

  el.innerHTML = `
    <!-- Target Analysis & Rank Prediction Strip -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
      <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px;">
        <h3 class="h3" style="color:var(--accent);margin-bottom:6px;">Target Assessment</h3>
        <p style="margin:0 0 6px;font-size:13.5px;"><strong>URL:</strong> ${esc(prop(target, "targetUrl") || "–")}</p>
        <p style="margin:0 0 6px;font-size:13.5px;"><strong>Intent Fit:</strong> <span class="pill ${intentFit==='High'?'up':(intentFit==='Moderate'?'flat':'down')}">${esc(intentFit)}</span></p>
        <p style="margin:6px 0 0;font-size:13px;color:var(--ink-2);">${esc(prop(target, "overallDrawbackSummary") || "–")}</p>
      </div>

      <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px;">
        <h3 class="h3" style="color:var(--up);margin-bottom:6px;">Rank Prediction Impact</h3>
        <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;">
          <div><span style="font-size:11.5px;color:var(--ink-3);">Current</span><div style="font-size:20px;font-weight:800;">${curPosDisplay}</div></div>
          <div>${icons.arrow}</div>
          <div><span style="font-size:11.5px;color:var(--ink-3);">Projected</span><div style="font-size:20px;font-weight:800;color:var(--up);">${projPosDisplay}</div></div>
