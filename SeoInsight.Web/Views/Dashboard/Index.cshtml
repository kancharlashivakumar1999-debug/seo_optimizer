        <h3 class="h3" style="color:var(--accent);margin-bottom:6px;">Target Assessment</h3>
        <p style="margin:0 0 6px;font-size:13.5px;"><strong>URL:</strong> ${esc(data.targetAnalysis?.targetUrl)}</p>
        <p style="margin:0 0 6px;font-size:13.5px;"><strong>Intent Fit:</strong> <span class="pill ${data.targetAnalysis?.currentIntentFit==='High'?'up':(data.targetAnalysis?.currentIntentFit==='Moderate'?'flat':'down')}">${esc(data.targetAnalysis?.currentIntentFit)}</span></p>
        <p style="margin:6px 0 0;font-size:13px;color:var(--ink-2);">${esc(data.targetAnalysis?.overallDrawbackSummary)}</p>
      </div>

      <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px;">
        <h3 class="h3" style="color:var(--up);margin-bottom:6px;">Rank Prediction Impact</h3>
        <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;">
          <div><span style="font-size:11.5px;color:var(--ink-3);">Current</span><div style="font-size:20px;font-weight:800;">#${data.rankPrediction?.baselinePosition}</div></div>
          <div>${icons.arrow}</div>
          <div><span style="font-size:11.5px;color:var(--ink-3);">Projected</span><div style="font-size:20px;font-weight:800;color:var(--up);">#${data.rankPrediction?.projectedPosition}</div></div>
          <div style="margin-left:auto;"><span class="pill up">${esc(data.rankPrediction?.projectedRange)}</span></div>
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--ink-2);"><strong>Timeline:</strong> ${esc(data.rankPrediction?.timelineWeeks)} | <strong>Confidence:</strong> ${(data.rankPrediction?.confidenceScore*100).toFixed(0)}%</p>
      </div>
    </div>

    <!-- Gap Analysis -->
    <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:16px;">
      <h3 class="h3" style="margin-bottom:10px;">Competitive Gap Analysis</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div>
          <strong style="font-size:13px;color:var(--down);">Our Major Drawbacks:</strong>
          <ul class="bul iss" style="font-size:13px;">
            ${(data.gapAnalysis?.ourMajorDrawbacks||[]).map(d=>`<li>${esc(d)}</li>`).join("")}
          </ul>
        </div>
        <div>
          <strong style="font-size:13px;color:var(--up);">Competitor Advantages:</strong>
          <ul class="bul win" style="font-size:13px;">
            ${(data.gapAnalysis?.competitorAdvantages||[]).map(a=>`<li>${esc(a)}</li>`).join("")}
          </ul>
        </div>
      </div>
      <div style="margin-top:10px;">
        <strong style="font-size:13px;">Missing Content Topics &amp; Questions:</strong>
        <div class="chips" style="margin-top:6px;">
          ${(data.gapAnalysis?.missingContentTopics||[]).map(t=>`<span class="chip" style="background:var(--surface-2);">${esc(t)}</span>`).join("")}
        </div>
      </div>
    </div>

    <!-- Top 5 Competitors Deep Dive -->
    <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:16px;">
      <h3 class="h3" style="margin-bottom:8px;">Top 5 Ranking Competitors Deep Dive</h3>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Rank</th><th>Competitor</th><th>Why They Are Ahead</th><th>Content Angle</th></tr></thead>
          <tbody>
            ${(data.competitorDeepDive||[]).map(c=>`
              <tr>
                <td><span class="rank ${c.position<=3?'t3':'t10'}">#${c.position}</span></td>
                <td><strong>${esc(c.competitorName)}</strong><div class="muted" style="font-size:11.5px;">${esc(c.url)}</div></td>
                <td style="max-width:280px;white-space:normal;font-size:13px;">${esc(c.whyTheyAreAhead)}</td>
                <td style="max-width:260px;white-space:normal;font-size:13px;color:var(--ink-2);">${esc(c.contentAngle)}</td>
