    </div>
    <div class="c-card" style="text-align:center;padding:40px;">
      <span class="spin" style="margin-right:8px"></span> Loading run results from PostgreSQL...
    </div>
  `;

  let serpCompetitors = [];
  let existingAnalysis = null;
  let requestedSerpUrl = null;
  let debugLogs = [];
  let currentTask = null;

  try {
    const res = await fetch("/Dashboard/GetRunDetail?id=" + encodeURIComponent(runId));
    if (res.ok) {
      const detail = await res.json();
      serpCompetitors = detail.competitors || [];
      requestedSerpUrl = detail.requestedSerpUrl || null;
      debugLogs = detail.debugUrls || [];

      if (detail.ragPayload) {
        currentTask = tasks.find(t => t.id === detail.ragPayload.taskId);
        currentRagInputs[runId] = [{
          runId: detail.ragPayload.runId,
          taskId: detail.ragPayload.taskId,
          keyword: detail.ragPayload.targetKeyword,
          location: detail.ragPayload.targetLocation,
          targetWebsite: detail.ragPayload.targetWebsite,
          ownRankPosition: detail.ragPayload.ownRankPosition,
          topCompetitors: JSON.parse(detail.ragPayload.topCompetitorsJson || "[]"),
          peopleAlsoAsk: JSON.parse(detail.ragPayload.peopleAlsoAskJson || "[]"),
          ingestedChunks: JSON.parse(detail.ragPayload.ingestedChunksJson || "[]"),
          systemPrompt: detail.ragPayload.systemPrompt,
          userPrompt: detail.ragPayload.userPrompt
        }];
      }

      if (detail.analysis) {
        existingAnalysis = {
          targetAnalysis: JSON.parse(detail.analysis.targetAnalysisJson || "{}"),
          competitorDeepDive: JSON.parse(detail.analysis.competitorDeepDiveJson || "[]"),
          gapAnalysis: JSON.parse(detail.analysis.gapAnalysisJson || "{}"),
          recommendedModifications: JSON.parse(detail.analysis.recommendedModificationsJson || "{}"),
          rankPrediction: JSON.parse(detail.analysis.rankPredictionJson || "{}")
        };
        currentAnalyses[runId] = existingAnalysis;
      }
    }
  } catch(e) {
    console.warn("Failed to fetch run detail", e);
  }

  v.innerHTML = `
    <div style="font-size:13px;color:var(--c-muted);margin-bottom:12px;">
      <a href="#dashboard" style="color:var(--c-accent);text-decoration:none;">Dashboard</a> / 
      ${currentTask ? `<a href="#task-${currentTask.id}" style="color:var(--c-accent);text-decoration:none;">${esc(currentTask.name)}</a> / ` : ''}
      Run Report
    </div>

    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px;flex-wrap:wrap">
      <div>
        <h1 style="font-size:24px;font-weight:700;margin:0;">SERP Run &amp; Competitive Analysis</h1>
        <div class="c-lbl" style="margin-top:4px;display:flex;gap:14px;flex-wrap:wrap;">
          <span>Run ID: <code>${runId}</code></span>
          ${currentTask ? `<span>Website: <b>${esc(currentTask.website)}</b></span>` : ''}
        </div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <button class="btn primary" id="btnStartAnalyzing" data-runid="${runId}">
          <i class="ti ti-sparkles"></i> Start Analyzing
        </button>
      </div>
    </div>

    ${debugLogs.length ? `
      <div class="c-card" style="margin-bottom:16px;background:var(--surface-2);">
        <p class="c-lbl" style="font-weight:600;margin-bottom:4px;"><i class="ti ti-bug"></i> Debug: SERP API Requested URLs</p>
        <div style="max-height:100px;overflow:auto;font-size:11.5px;font-family:monospace;">
          ${debugLogs.map(l => `<div style="margin-bottom:2px;">[${fmtDT(l.createdAt)}] Page ${l.page || 1}: <a href="${esc(l.url)}" target="_blank" style="color:var(--c-accent)">${esc(l.url)}</a></div>`).join("")}
        </div>
      </div>
    ` : ''}

    <!-- RAG Analysis Results Container -->
    <div class="c-card" id="ragAnalysisOutputBox" style="${existingAnalysis ? '' : 'display:none;'}margin-bottom:16px;border:1.5px solid var(--c-accent);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <h3 style="font-size:15px;margin:0;font-weight:600;display:flex;align-items:center;gap:6px;">
          <i class="ti ti-sparkles" style="color:var(--c-accent);"></i> AI Competitive Gap Analysis &amp; Action Plan
        </h3>
        <span class="pill" style="background:var(--c-accent-bg);color:var(--c-accent);">Powered by Google Gemini</span>
      </div>
      <div id="ragAnalysisSpinner" style="display:none;padding:24px 0;justify-content:center;align-items:center;gap:8px;">
        <span class="spin"></span> Analyzing competitors and predicting ranking impact...
      </div>
      <div id="ragAnalysisContent"></div>
    </div>

    <!-- SERP Organic Results Table -->
    <div class="c-card">
      <h3 style="font-size:15px;margin:0 0 8px;font-weight:600;">SERP Organic Results</h3>
      <div class="tbl-wrap">
        <table class="tbl-custom" style="width:100%;border-collapse:collapse;">
          <thead>
            <tr>
              <th style="width:8%">Rank</th>
              <th style="width:25%">Domain</th>
              <th style="width:35%">Title</th>
              <th>Snippet</th>
            </tr>
          </thead>
          <tbody>
            ${serpCompetitors.length ? serpCompetitors.map(c => `
              <tr>
                <td><b>#${c.position}</b></td>
                <td><b>${esc(c.domain)}</b> ${c.isTargetSite ? '<span class="pill" style="background:var(--c-up-bg);color:var(--c-up);margin-left:4px;">Target</span>' : ''}</td>
                <td>${esc(c.title)}</td>
                <td style="color:var(--c-sub);font-size:12px;">${esc(c.snippet || c.url)}</td>
              </tr>
            `).join("") : `<tr><td colspan="4" class="c-lbl" style="text-align:center;padding:24px;">No competitors found for this run.</td></tr>`}
          </tbody>
        </table>
      </div>
    </div>
  `;

  if(existingAnalysis) {
    renderAnalysisOutput(existingAnalysis);
  }
}

/* ---------- SPA Routing ---------- */
function route(){
  const h = location.hash.slice(1) || "dashboard";
  const deep = h.startsWith("task-") || h.startsWith("report-");
  $("#nav").innerHTML = navHTML(deep ? "tasks" : h);
  $("#navM").innerHTML = navHTML(deep ? "tasks" : h);

  if(h.startsWith("report-")){
    const runId = h.slice(7);
    window.scrollTo(0,0);
    return renderReport(runId);
  }
  if(h.startsWith("task-")){
    const taskId = h.slice(5);
    const t = tasks.find(x => x.id === taskId);
    if(t) return renderDetail(t);
    location.hash = "tasks";
    return;
  }
  if(h === "tasks") return renderTasks();
  renderDashboard();
}

window.addEventListener("hashchange", route);

/* ---------- Global UI Click Handlers ---------- */
let editTaskId = null;
let currentRunTaskId = null;

function openTaskModal(t = null){
  editTaskId = t ? t.id : null;
  $("#tmTitle").innerHTML = `<i class="ti ti-${t ? 'edit' : 'plus'}"></i> ${t ? 'Edit ranking task' : 'New ranking task'}`;
  $("#fName").value = t ? t.name : "";
  $("#fSite").value = t ? t.website : "";
  $("#fKeyword").value = t ? t.keyword : "";
  $("#fLocation").value = t ? t.location : "";
  $("#fPrompt").value = t ? t.prompt : DEFAULT_PROMPT;
  $("#taskModal").classList.add("open");
  setTimeout(() => $("#fName").focus(), 40);
}

function openRunModal(taskId){
  const t = tasks.find(x => x.id === taskId);
  if(!t) return;
  currentRunTaskId = taskId;
  $("#rmTitle").innerHTML = `<i class="ti ti-player-play"></i> Run Task: “${esc(t.name)}”`;
  $("#fNote").value = "";
  $("#runProg").hidden = true;
  $("#ragInspectBox").style.display = "none";
  $("#runBar").style.width = "0";
  $("#runGo").disabled = false;
  $("#runModal").classList.add("open");
}

function closeModals(){
  $$(".scrim").forEach(m => m.classList.remove("open"));
}
$$("[data-close]").forEach(b => b.onclick = closeModals);

$("#saveTask").onclick = async () => {
  const name = $("#fName").value.trim();
  const site = normDomain($("#fSite").value);
  const kw = $("#fKeyword").value.trim();
  const loc = $("#fLocation").value.trim();
  const prompt = $("#fPrompt").value.trim();

  if(!site) { toast("Enter website to track", true); return $("#fSite").focus(); }
  if(!kw) { toast("Enter target keyword", true); return $("#fKeyword").focus(); }
  if(!loc) { toast("Enter target location", true); return $("#fLocation").focus(); }

  const taskPayload = {
    id: editTaskId || "",
    name: name || site,
    website: site,
    keyword: kw,
    location: loc,
    keywords: [kw],
    locations: [loc],
    prompt: prompt || DEFAULT_PROMPT
  };

  const ok = await saveTask(taskPayload);
  if(ok) {
    closeModals();
    toast(editTaskId ? "Task updated" : "Task created");
    route();
  }
};

$("#runGo").onclick = async () => {
  const t = tasks.find(x => x.id === currentRunTaskId);
  if(!t) return;
  $("#runGo").disabled = true;
  const res = await executeLiveRun(t, $("#fNote").value, []);
  if(res && res.runId) {
    toast("Live SERP analyzed!");
    setTimeout(() => {
      closeModals();
      location.hash = "report-" + res.runId;
    }, 400);
  } else {
    $("#runGo").disabled = false;
  }
};

document.addEventListener("click", e => {
  if(e.target.closest("[data-new]")) { openTaskModal(); return; }
  
  const ed = e.target.closest("[data-edit]");
  if(ed) {
    e.stopPropagation();
    const t = tasks.find(x => x.id === ed.dataset.edit);
    if(t) openTaskModal(t);
    return;
  }

  const rn = e.target.closest("[data-run]");
  if(rn) {
    e.stopPropagation();
    openRunModal(rn.dataset.run);
    return;
  }

  const dl = e.target.closest("[data-del]");
  if(dl) {
    e.stopPropagation();
    const t = tasks.find(x => x.id === dl.dataset.del);
    if(t && confirm(`Are you sure you want to delete task "${t.name}"?`)) {
      removeTask(t.id).then(() => {
        toast("Task deleted");
        location.hash = "tasks";
        route();
      });
    }
    return;
  }

  const sa = e.target.closest("#btnStartAnalyzing");
  if(sa) {
    e.stopPropagation();
    const rId = sa.dataset.runid;
    if(rId) startAnalyzingRag(rId);
    return;
  }
});

document.addEventListener("change", e => {
  if(e.target.id === "taskFilterSelect") {
    renderRecentRunsRows(e.target.value);
  }
});

const themeBtn = $("#themeBtn");
if(themeBtn) {
  themeBtn.onclick = () => {
    const rt = document.documentElement;
    const isDark = rt.dataset.theme === "dark" || matchMedia('(prefers-color-scheme: dark)').matches;
    rt.dataset.theme = isDark ? "light" : "dark";
    if(location.hash === "" || location.hash === "#dashboard") {
      renderDashboard();
    }
  };
}

// Initial boot
setStatus();
syncFromDb().then(() => route());
})();
</script>
}
