        <div style="background:var(--surface-2);padding:10px;border-radius:var(--radius);">
          <strong>Recommended Meta Description:</strong>
          <div style="font-weight:600;margin:3px 0;">${esc(data.recommendedModifications?.metaDescription?.recommended)}</div>
