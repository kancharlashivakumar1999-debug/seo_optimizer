    </div>
  </div>`;

  if(existingAnalysis) {
    renderAnalysisOutput(existingAnalysis);
  }
}

/* ---------- task modal ---------- */
let editId=null;

function openTaskModal(t){
  editId=t?t.id:null;
  $("#tmTitle").textContent=t?"Edit ranking task":"New ranking task";
  $("#fName").value=t?.name||"";
  $("#fSite").value=t?.website||"";
  $("#fKeyword").value=t?.keyword || (t?.keywords && t.keywords[0]) || "";
  $("#fLocation").value=t?.location || (t?.locations && t.locations[0]) || "";
  $("#fPrompt").value=t?.prompt||DEFAULT_PROMPT;
  $("#taskModal").classList.add("open");
  setTimeout(()=>$("#fName").focus(),30);
}

$("#saveTask").onclick=async()=>{
  const name=$("#fName").value.trim();
  const site=normDomain($("#fSite").value);
  const kw=$("#fKeyword").value.trim();
  const loc=$("#fLocation").value.trim();
  const prompt=$("#fPrompt").value.trim();

  if(!site){toast("Add website to track");return $("#fSite").focus()}
  if(!kw){toast("Add target keyword");return $("#fKeyword").focus()}
  if(!loc){toast("Add target location");return $("#fLocation").focus()}

  const currentRuns = (editId && tasks.find(x=>x.id===editId)?.runs) || [];
  const t={
    id: editId || "",
    name: name || site,
    website: site,
    keyword: kw,
    location: loc,
    keywords: [kw],
    locations: [loc],
    prompt: prompt,
    runs: currentRuns
  };

  const saved = await saveTask(t);
  if (saved) {
    closeModals();
    toast(editId ? "Task updated successfully" : "Task created successfully");

    // Refresh view
    if (editId && location.hash.startsWith("#task-")) {
      renderDetail(t);
    } else {
      location.hash="tasks";
      route();
    }
  }
};

/* ---------- run modal ---------- */
let runTaskId=null;
function openRunModal(id){
  const t=tasks.find(x=>x.id===id);if(!t)return;
  runTaskId=id;
  $("#rmTitle").textContent="Run live SERP: “"+t.name+"”";
  $("#fNote").value="";
  $("#runProg").hidden=true;
  $("#ragInspectBox").style.display="none";
  $("#runBar").style.width="0";
  $("#runGo").disabled=false;
  $("#runModal").classList.add("open");
}

$("#runGo").onclick=async()=>{
  const t=tasks.find(x=>x.id===runTaskId);if(!t)return;
  $("#runGo").disabled=true;
  const run = await executeLiveRun(t, $("#fNote").value, []);
  if(run) {
    if(!t.runs) t.runs = [];
    t.runs.push(run);
    toast("Live SERP queried and saved in PostgreSQL!");
    setTimeout(()=>{
      closeModals();
      location.hash=reportHash(t, t.runs.length - 1);
    }, 400);
  } else {
    $("#runGo").disabled=false;
  }
};

function closeModals(){$$(".scrim").forEach(m=>m.classList.remove("open"));}
$$("[data-close]").forEach(b=>b.onclick=closeModals);
// Prevent backdrop click from dismissing the modal dialog (close only on completion or close icon/cancel button)

/* ---------- Global clicks ---------- */
document.addEventListener("click",e=>{
  if(e.target.closest("[data-new]")){openTaskModal();return}
  const ed=e.target.closest("[data-edit]");
  if(ed){
    e.stopPropagation();
    const id=ed.dataset.edit;
    const t=tasks.find(x=>x.id===id);
    if(t) openTaskModal(t);
    return;
  }
  const sa=e.target.closest("#btnStartAnalyzing, [data-analyze]");
  if(sa){
    e.stopPropagation();
    const runId = sa.dataset.runid || sa.getAttribute("data-runid");
    if(runId) {
      startAnalyzingRag(runId, 0);
      return;
    }
  }
  const r=e.target.closest("[data-run]");if(r){e.stopPropagation();openRunModal(r.dataset.run);return}
  const d=e.target.closest("[data-del]");if(d){const t=tasks.find(x=>x.id===d.dataset.del);if(t&&confirm(`Delete “${t.name}”?`)){removeTask(t.id);location.hash="tasks";toast("Task deleted from PostgreSQL");route();}return}
  const hr=e.target.closest("[data-href]");if(hr){location.hash=hr.dataset.href;return}
  const g=e.target.closest("[data-go]");if(g){location.hash="task-"+g.dataset.go}
});

$("#themeBtn").onclick=()=>{const rt=document.documentElement;const dark=rt.dataset.theme?rt.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches;rt.dataset.theme=dark?"light":"dark";route()};

  // Expose methods needed by inline HTML onclick handlers or window scope
  window.startAnalyzingRag = startAnalyzingRag;
  window.openTaskModal = openTaskModal;

  setStatus();
  syncFromDb().then(() => route());
})();
</script>
}
