function initDashboardChart(){
  const canvas = $("#rankChartCanvas");
  if(!canvas) return;

  const dark = document.documentElement.dataset.theme === "dark" || matchMedia('(prefers-color-scheme: dark)').matches;
  const gridColor = dark ? '#2c3853' : '#d9dfe8';
  const mutedColor = dark ? '#7c889d' : '#7a8699';

  const chartTasks = tasks.filter(t => t.recentRanks && t.recentRanks.length > 0);
  const maxPoints = Math.max(6, ...chartTasks.map(t => t.recentRanks.length));
  const labels = Array.from({length: maxPoints}, (_, i) => "Run " + (i + 1));

  const datasets = chartTasks.map((t, idx) => {
    let data = [...t.recentRanks];
    while(data.length < maxPoints && data.length > 0) {
      data.unshift(data[0]); // Pad backwards for visual continuity if needed
    }
    return {
      label: t.name,
      data: data,
      borderColor: t.color,
      backgroundColor: t.color,
      borderWidth: 2,
      borderDash: t.dash,
      pointRadius: 3,
      pointHoverRadius: 5,
      tension: 0.3
    };
  });

  activeChart = new Chart(canvas, {
    type: 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: c => ' ' + c.dataset.label + ': #' + c.parsed.y
          }
        }
      },
      scales: {
        y: {
          reverse: true,
          min: 1,
          ticks: { color: mutedColor, font: { size: 11 }, callback: v => '#' + v, stepSize: 5 },
          grid: { color: gridColor },
          border: { display: false }
        },
        x: {
          ticks: { color: mutedColor, font: { size: 11 } },
          grid: { display: false }
        }
      }
    }
  });

  const chipsContainer = $("#taskChips");
  if(chipsContainer) {
    chipsContainer.innerHTML = "";
    chartTasks.forEach((t, i) => {
      const chip = document.createElement("span");
      chip.className = "chip on";
      chip.innerHTML = `<span style="width:10px;height:3px;border-radius:2px;background:${t.color}"></span>${esc(t.name)}`;
      chip.onclick = () => {
        chartFocusIndex = chartFocusIndex === i ? null : i;
        activeChart.data.datasets.forEach((ds, j) => {
          const on = chartFocusIndex === null || chartFocusIndex === j;
          ds.borderColor = on ? chartTasks[j].color : (dark ? '#383835' : '#d3d1c7');
          ds.backgroundColor = ds.borderColor;
          ds.borderWidth = chartFocusIndex === j ? 3 : 2;
        });
        [...chipsContainer.children].forEach((c, j) => c.classList.toggle('on', chartFocusIndex === null || chartFocusIndex === j));
        activeChart.update();
      };
      chipsContainer.appendChild(chip);
    });
  }
}

function renderTaskOverviewRows(){
  const tb = $("#taskOverviewTbody");
  if(!tb) return;

  if(!tasks.length) {
    tb.innerHTML = `<tr><td colspan="7" class="c-lbl" style="text-align:center;padding:24px;">No ranking tasks found. Click "New task" to begin.</td></tr>`;
    return;
  }

  tb.innerHTML = tasks.map((t, idx) => {
    const ranks = t.recentRanks.length ? t.recentRanks : [t.latestRank || 20];
    const latest = ranks[ranks.length - 1];
    const prev = ranks.length > 1 ? ranks[ranks.length - 2] : latest;
    const dl = prev - latest;
    const mx = Math.max(...ranks), mn = Math.min(...ranks);
    const pts = ranks.map((v, j) => (j * 16) + ',' + (2 + ((v - mn) / (mx - mn || 1)) * 16)).join(' ');
    const changeClass = dl >= 0 ? "up" : "dn";
    const changeArrow = dl > 0 ? "↑" : (dl < 0 ? "↓" : "");
    const changeDisplay = dl !== 0 ? `${changeArrow}${Math.abs(dl)}` : "0";

    return `
      <tr style="cursor:pointer;" onclick="location.hash='task-${t.id}'">
        <td style="font-weight:600;">
          <span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:${t.color};margin-right:6px"></span>
          ${esc(t.name)}
        </td>
        <td style="color:var(--c-sub);">${esc(t.keyword)}</td>
        <td>${t.totalRuns}</td>
        <td><b>#${latest}</b></td>
        <td class="${changeClass}"><b>${changeDisplay}</b></td>
        <td>
          <svg width="84" height="20" aria-hidden="true">
            <polyline points="${pts}" fill="none" stroke="${t.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </td>
        <td style="text-align:right;color:var(--c-sub);">${fmtDT(t.lastRunAt)}</td>
      </tr>
    `;
  }).join("");
}

function renderRecentRunsRows(filterTaskId = ""){
  const tb = $("#recentRunsTbody");
  if(!tb) return;

  let allRuns = [];
  tasks.forEach(t => {
    if(filterTaskId && t.id !== filterTaskId) return;
    (t.recentRanks || []).forEach((rk, i) => {
      allRuns.push({
        taskId: t.id,
        taskName: t.name,
        runNumber: i + 1,
        when: t.lastRunAt,
        score: Math.min(100, Math.max(40, 100 - rk * 3)),
        rank: rk,
        change: i > 0 ? (t.recentRanks[i-1] - rk) : 0,
        status: "Completed"
      });
    });
  });

  if(!allRuns.length) {
    tb.innerHTML = `<tr><td colspan="6" class="c-lbl" style="text-align:center;padding:24px;">No execution runs recorded yet. Open a task to run live SERP.</td></tr>`;
    return;
  }

  allRuns.reverse();

  tb.innerHTML = allRuns.slice(0, 8).map(r => {
    const changeClass = r.change >= 0 ? "up" : "dn";
    const changeTxt = r.change > 0 ? `↑${r.change}` : (r.change < 0 ? `↓${Math.abs(r.change)}` : "");
    return `
      <tr style="cursor:pointer;" onclick="location.hash='task-${r.taskId}'">
        <td style="font-weight:600;">${esc(r.taskName)}</td>
        <td>#${r.runNumber}</td>
        <td style="color:var(--c-sub);">${fmtDT(r.when)}</td>
        <td>${r.score}</td>
        <td>#${r.rank} <span class="${changeClass}">${changeTxt}</span></td>
        <td style="text-align:right;">
          <span class="pill" style="background:var(--c-up-bg);color:var(--c-up);">
            <i class="ti ti-check"></i> ${r.status}
          </span>
        </td>
      </tr>
    `;
  }).join("");
}

