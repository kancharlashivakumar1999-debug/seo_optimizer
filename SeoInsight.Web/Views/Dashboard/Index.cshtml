            ${(data.recommendedModifications?.actionPlan||[]).map(act=>`
              <tr>
                <td><strong>#${act.priority}</strong></td>
                <td style="white-space:normal;font-size:13.5px;">${esc(act.action)}</td>
                <td><span class="chip">${esc(act.owner)}</span></td>
                <td>${esc(act.effort)}</td>
