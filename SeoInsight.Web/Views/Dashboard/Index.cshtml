/* ---------- Task detail ---------- */
async function renderDetail(t){
  const current = tasks.find(x=>x.id===t.id) || t;
  const v=$("#dynamicContainer");

  // Load latest execution runs directly from PostgreSQL
  let runs = current.runs || [];
  try {
    const res = await fetch("/Dashboard/GetTaskDetail?id=" + encodeURIComponent(current.id));
    if (res.ok) {
      const data = await res.json();
      if (data.task) {
        let kw = [];
        try { kw = JSON.parse(data.task.targetKeywordsJson || "[]"); } catch(e){}
        let loc = [];
        try { loc = JSON.parse(data.task.targetLocationsJson || "[]"); } catch(e){}
        current.name = data.task.taskName || current.name;
        current.website = data.task.targetWebsite || current.website;
        current.prompt = data.task.promptTemplate || current.prompt;
        current.keyword = data.task.targetKeyword || (kw.length ? kw[0] : current.keyword || "");
        current.location = data.task.targetLocation || (loc.length ? loc[0] : current.location || "");
        current.keywords = [current.keyword];
        current.locations = [current.location];
      }
      if (data.runs && data.runs.length) {
        runs = data.runs.map((r, idx) => ({
          id: r.runId,
          at: new Date(r.startedAt).getTime(),
          note: r.runNote || "",
          implemented: JSON.parse(r.implementedChangesJson || "[]"),
          score: r.visibilityScore,
          avgRank: r.averageRank,
          status: r.runStatus,
          hasGapAnalysis: r.hasGapAnalysis
        }));
        current.runs = runs;
      }
    }
  } catch(e) {
    console.warn("Could not load runs from DB", e);
  }

  const hasRuns = runs.length > 0;
  const latestRun = hasRuns ? runs[0] : null;

  v.innerHTML=`<div class="crumb"><a href="#tasks">Tasks</a> / ${esc(current.name)}</div>
  <div class="head">
    <div>
      <h1>${esc(current.name)}</h1>
      <div class="meta-row">
        <span>Website: <b>${esc(current.website)}</b></span>
        <span>Keyword: <b>${esc(current.keyword || (current.keywords||[])[0] || "–")}</b></span>
        <span>Location: <b>${esc(current.location || (current.locations||[])[0] || "–")}</b></span>
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" data-edit="${current.id}">Edit Task</button>
      <button class="btn danger" data-del="${current.id}">Delete</button>
      <button class="btn primary" data-run="${current.id}">
        ${icons.play}${hasRuns ? "Run again" : "Run now"}
      </button>
    </div>
  </div>

  ${hasRuns ? `
  <div class="panel" style="margin-bottom:18px">
    <h2>Execution Runs History (${runs.length})</h2>
    <p class="sub">Click any run to view its live SERP results, RAG Input payload, and AI competitive analysis.</p>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            <th>Run</th>
            <th>Executed At</th>
            <th class="num">Visibility</th>
            <th class="num">Avg Rank</th>
            <th>AI Analysis</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          ${runs.map((r, idx) => `
            <tr class="click" data-href="${reportHash(current, idx)}" style="cursor:pointer;">
              <td><b>Run #${runs.length - idx}</b></td>
              <td class="muted">${fmtDT(r.at)}</td>
              <td class="num"><span class="pill ${r.score >= 50 ? 'up' : 'flat'}">${r.score}%</span></td>
              <td class="num"><b>${fmtRank(r.avgRank)}</b></td>
              <td>${r.hasGapAnalysis ? '<span class="pill up">AI Analyzed</span>' : '<span class="pill flat">RAG Ready</span>'}</td>
              <td><button class="btn sm" data-href="${reportHash(current, idx)}">Open Report</button></td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>
  </div>
  ` : emptyRunsState(current.id)}`;
}

/* ---------- Report Page (with Start Analyzing & RAG Input Display) ---------- */
async function renderReport(t,i){
  const current = tasks.find(x=>x.id===t.id) || t;
  const run=current.runs ? current.runs[i] : null;
  const v=$("#dynamicContainer");
  const runId = run ? run.id : (typeof i === 'string' ? i : null);

  v.innerHTML=`<div class="crumb"><a href="#tasks">Tasks</a> / <a href="#task-${current.id}">${esc(current.name)}</a> / Run ${typeof i==='number' ? i+1 : ''} Report</div>
  <div class="loading-box"><span class="spin"></span> Loading run results and RAG payload from PostgreSQL...</div>`;

  let ragData = runId ? currentRagInputs[runId] : null;
  let existingAnalysis = runId ? currentAnalyses[runId] : null;
  let serpCompetitors = [];

  if (runId) {
    try {
      const res = await fetch("/Dashboard/GetRunDetail?id=" + encodeURIComponent(runId));
      if (res.ok) {
        const detail = await res.json();
        if (detail.competitors) {
          serpCompetitors = detail.competitors;
        }

        if (detail.ragPayload) {
          try {
            const topComps = JSON.parse(detail.ragPayload.topCompetitorsJson || "[]");
            const chunks = JSON.parse(detail.ragPayload.ingestedChunksJson || "[]");
            const paa = JSON.parse(detail.ragPayload.peopleAlsoAskJson || "[]");
            ragData = [{
              runId: detail.ragPayload.runId,
              taskId: detail.ragPayload.taskId,
              keyword: detail.ragPayload.targetKeyword,
              location: detail.ragPayload.targetLocation,
              targetWebsite: detail.ragPayload.targetWebsite,
              ownRankPosition: detail.ragPayload.ownRankPosition,
              topCompetitors: topComps,
              peopleAlsoAsk: paa,
              ingestedChunks: chunks,
              systemPrompt: detail.ragPayload.systemPrompt,
              userPrompt: detail.ragPayload.userPrompt
            }];
            currentRagInputs[runId] = ragData;
          } catch(e){}
        }

        if (detail.analysis) {
          try {
            existingAnalysis = {
              targetAnalysis: JSON.parse(detail.analysis.targetAnalysisJson || "{}"),
              competitorDeepDive: JSON.parse(detail.analysis.competitorDeepDiveJson || "[]"),
              gapAnalysis: JSON.parse(detail.analysis.gapAnalysisJson || "{}"),
              recommendedModifications: JSON.parse(detail.analysis.recommendedModificationsJson || "{}"),
              rankPrediction: JSON.parse(detail.analysis.rankPredictionJson || "{}")
            };
            currentAnalyses[runId] = existingAnalysis;
          } catch(e){}
        }
      }
    } catch(e){
      console.warn("Failed to fetch run detail", e);
    }
  }

  const runDate = run ? fmtDT(run.at) : "Recent Run";

  v.innerHTML=`<div class="crumb"><a href="#tasks">Tasks</a> / <a href="#task-${current.id}">${esc(current.name)}</a> / Run Details</div>
  <div class="head">
    <div>
      <h1>Live SERP Run &amp; Competitive Analysis</h1>
